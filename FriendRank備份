<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>好友排行榜</title>
<script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Noto Sans TC", Arial, sans-serif;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 28, 92, 0.18), transparent 34%),
      radial-gradient(circle at 80% 18%, rgba(0, 192, 255, 0.18), transparent 36%),
      linear-gradient(135deg, #0f1428 0%, #1b2244 100%);
    color: #fff;
    min-height: 100vh;
    padding: max(20px, env(safe-area-inset-top)) 20px max(28px, env(safe-area-inset-bottom));
    display: flex;
    justify-content: center;
  }

  .container {
    width: 100%;
    max-width: 480px;
  }

  .header {
    text-align: center;
    margin-bottom: 20px;
  }

  .header h1 {
    font-size: 24px;
    margin-bottom: 4px;
    letter-spacing: 0.02em;
    text-shadow: 0 0 14px rgba(255, 224, 95, 0.24);
  }

  .header p {
    color: #9aa3c4;
    font-size: 13px;
  }

  .loading-state {
    text-align: center;
    padding: 60px 20px;
    color: #9aa3c4;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 4px solid #2a3358;
    border-top-color: #ffe05f;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 12px;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .invite-card {
    background: linear-gradient(135deg, #ffe05f 0%, #ffb84d 100%);
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 14px;
    color: #10172f;
    text-align: center;
    box-shadow: 0 8px 20px rgba(255, 224, 95, 0.25);
  }

  .invite-card .title {
    font-size: 15px;
    font-weight: 900;
    margin-bottom: 6px;
  }

  .invite-card .desc {
    font-size: 12px;
    opacity: 0.82;
    margin-bottom: 12px;
    line-height: 1.5;
    font-weight: 700;
  }

  .invite-btn {
    background: #10172f;
    color: #ffe05f;
    border: none;
    padding: 12px 24px;
    border-radius: 12px;
    font-weight: 900;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
    box-shadow: 0 8px 18px rgba(16, 23, 47, 0.22);
  }

  .invite-btn:active {
    transform: scale(0.97);
  }

  .reward-card {
    background: rgba(27, 34, 68, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 16px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 10px 24px rgba(0, 0, 0, 0.18);
  }

  .reward-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .reward-header .label {
    font-size: 13px;
    color: #9aa3c4;
    white-space: nowrap;
  }

  .reward-header .tier-name {
    font-size: 14px;
    font-weight: 900;
    color: #ffe05f;
    text-align: right;
  }

  .tier-track {
    display: flex;
    justify-content: space-between;
    position: relative;
    margin: 20px 8px 8px 8px;
  }

  .tier-track::before {
    content: "";
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    height: 4px;
    background: #2a3358;
    border-radius: 4px;
    z-index: 0;
  }

  .tier-track .progress-fill {
    position: absolute;
    top: 14px;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, #ffe05f, #ffb84d);
    border-radius: 4px;
    z-index: 1;
    transition: width 0.4s;
  }

  .tier-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
    position: relative;
  }

  .tier-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2a3358;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    border: 3px solid #1b2244;
  }

  .tier-circle.unlocked {
    background: linear-gradient(135deg, #ffe05f, #ffb84d);
    box-shadow: 0 0 14px rgba(255, 224, 95, 0.52);
  }

  .tier-label {
    font-size: 10px;
    color: #9aa3c4;
    margin-top: 4px;
  }

  .stat-bar {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    background: rgba(27, 34, 68, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 16px;
    font-size: 13px;
    color: #9aa3c4;
  }

  .stat-bar b {
    color: #ffe05f;
    font-size: 16px;
  }

  .list-title {
    font-size: 14px;
    color: #9aa3c4;
    margin-bottom: 10px;
    padding-left: 4px;
    font-weight: 800;
  }

  .rank-item {
    display: flex;
    align-items: center;
    background: rgba(27, 34, 68, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 10px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 8px 20px rgba(0, 0, 0, 0.16);
  }

  .rank-item.me {
    background: linear-gradient(135deg, rgba(42, 51, 88, 0.96) 0%, rgba(27, 34, 68, 0.94) 100%);
    border: 2px solid #ffe05f;
    box-shadow:
      0 0 0 1px rgba(255, 224, 95, 0.18),
      0 0 20px rgba(255, 224, 95, 0.18),
      0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .rank-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 15px;
    margin-right: 12px;
    flex-shrink: 0;
  }

  .rank-badge.gold {
    background: linear-gradient(135deg, #ffe05f, #ffb84d);
    color: #10172f;
    font-size: 20px;
  }

  .rank-badge.silver {
    background: linear-gradient(135deg, #d4d9e8, #a4acc9);
    color: #10172f;
    font-size: 20px;
  }

  .rank-badge.bronze {
    background: linear-gradient(135deg, #e8a25f, #c17b3a);
    color: #fff;
    font-size: 20px;
  }

  .rank-badge.normal {
    background: #2a3358;
    color: #9aa3c4;
  }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    object-fit: cover;
    margin-right: 10px;
    background: #2a3358;
    flex-shrink: 0;
    display: none;
  }

  .avatar.show {
    display: block;
  }

  .player-info {
    flex: 1;
    min-width: 0;
  }

  .player-name {
    font-size: 15px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .me-tag {
    background: #ffe05f;
    color: #10172f;
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 999px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .player-score {
    font-size: 12px;
    color: #9aa3c4;
    margin-top: 2px;
  }

  .rank-tag {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 900;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .rank-tag.S {
    background: #ffe05f;
    color: #10172f;
  }

  .rank-tag.A {
    background: #06c755;
    color: #fff;
  }

  .rank-tag.B {
    background: #3a4372;
    color: #fff;
  }

  .rank-tag.none {
    background: #2a3358;
    color: #666;
  }

  .score-value {
    font-size: 20px;
    font-weight: 900;
    color: #ffe05f;
    margin-left: 8px;
    min-width: 50px;
    text-align: right;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: #9aa3c4;
    line-height: 1.6;
  }

  .empty-state .icon {
    font-size: 48px;
    margin-bottom: 12px;
  }

  .toast {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 30px);
    left: 50%;
    transform: translateX(-50%);
    background: #06c755;
    color: #fff;
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 9999;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
  }

  .toast.show {
    opacity: 1;
  }

  .debug {
    margin-top: 12px;
    font-size: 11px;
    color: #5d6688;
    text-align: center;
    word-break: break-all;
    line-height: 1.5;
    padding-bottom: 12px;
  }

  .debug strong {
    color: #8993bd;
  }

  @media (max-width: 390px) {
    body {
      padding-left: 14px;
      padding-right: 14px;
    }

    .rank-item {
      padding: 12px 12px;
    }

    .rank-badge {
      width: 34px;
      height: 34px;
      margin-right: 9px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      margin-right: 8px;
    }

    .player-name {
      font-size: 14px;
    }

    .score-value {
      font-size: 18px;
      min-width: 42px;
    }

    .rank-tag {
      padding: 4px 8px;
      margin-left: 6px;
    }
  }
</style>
</head>

<body>

<div class="container">
  <div class="header">
    <h1>🌀 好友排行榜</h1>
    <p>看看誰是朋友圈裡最強的陀螺高手</p>
  </div>

  <div id="loading" class="loading-state">
    <div class="spinner"></div>
    <div id="loading-text">正在載入你的資料...</div>
  </div>

  <div id="main-content" style="display:none;">
    <div class="invite-card">
      <div class="title">🎯 邀請好友一起玩</div>
      <div class="desc">分享你的專屬連結，好友的成績會自動出現在排行榜上</div>
      <button class="invite-btn" onclick="shareInviteLink()">📱 分享給 LINE 好友</button>
    </div>

    <div class="reward-card">
      <div class="reward-header">
        <span class="label">邀請獎勵進度</span>
        <span class="tier-name" id="tier-name">尚未解鎖</span>
      </div>

      <div class="tier-track">
        <div class="progress-fill" id="progress-fill" style="width: 0%;"></div>

        <div class="tier-node">
          <div class="tier-circle" id="node-1">🥉</div>
          <div class="tier-label">1人</div>
        </div>

        <div class="tier-node">
          <div class="tier-circle" id="node-3">🥈</div>
          <div class="tier-label">3人</div>
        </div>

        <div class="tier-node">
          <div class="tier-circle" id="node-5">🥇</div>
          <div class="tier-label">5人</div>
        </div>
      </div>
    </div>

    <div class="stat-bar">
      <span>朋友圈人數 <b id="friend-count">0</b> 人</span>
      <span id="my-rank-text">我的排名 <b>-</b></span>
    </div>

    <div class="list-title">排行榜</div>
    <div id="rank-list"></div>
    <div class="debug" id="debug-text"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ============================================================
  // 設定區
  // ============================================================

  /*
   * 重要：
   * 這個 GAS_URL 已改成跟主遊戲 / Shopify Liquid 同一支。
   */
  var GAS_URL = "https://script.google.com/macros/s/AKfycbzXS64QzQ9eoWUVuYynIYIJ-lXfIJYw7ge8ICSnGRNCXbKax45ihne4mBN23SgqqOwGmg/exec";

  /*
   * 好友排行榜頁 LIFF ID
   */
  var LIFF_ID = "2007022255-lfPkJn2u";

  /*
   * 主遊戲 LIFF ID
   */
  var GAME_LIFF_ID = "2007022255-ph9gRwPs";

  var myUserId = "";
  var myPlayerName = "";
  var myPictureUrl = "";
  var myReferralCode = "";

  var lastFriendRankRaw = null;
  var lastInviteStatusRaw = null;
  var lastReferralCodeRaw = null;

  // ============================================================
  // 工具
  // ============================================================

  function setLoadingText(text) {
    var el = document.getElementById("loading-text");
    if (el) el.textContent = text;
  }

  function setDebug(text) {
    var el = document.getElementById("debug-text");
    if (el) el.innerHTML = text || "";
  }

  function showToast(msg) {
    var toast = document.getElementById("toast");
    toast.textContent = msg;
    toast.classList.add("show");

    setTimeout(function() {
      toast.classList.remove("show");
    }, 2500);
  }

  function escapeHtml(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function buildQuery(params) {
    var pairs = [];

    Object.keys(params || {}).forEach(function(key) {
      if (
        params[key] !== undefined &&
        params[key] !== null &&
        params[key] !== ""
      ) {
        pairs.push(
          encodeURIComponent(key) + "=" + encodeURIComponent(params[key])
        );
      }
    });

    return pairs.join("&");
  }

  function jsonp(action, params) {
    params = params || {};

    return new Promise(function(resolve, reject) {
      var callbackName =
        "zelo_jsonp_" +
        Date.now() +
        "_" +
        Math.floor(Math.random() * 100000);

      var script = document.createElement("script");
      var timeout;

      params.action = action;
      params.callback = callbackName;
      params._ts = Date.now();

      window[callbackName] = function(data) {
        clearTimeout(timeout);

        try {
          delete window[callbackName];
        } catch (err) {
          window[callbackName] = null;
        }

        if (script && script.parentNode) {
          script.parentNode.removeChild(script);
        }

        resolve(data || {});
      };

      script.onerror = function() {
        clearTimeout(timeout);

        try {
          delete window[callbackName];
        } catch (err) {
          window[callbackName] = null;
        }

        if (script && script.parentNode) {
          script.parentNode.removeChild(script);
        }

        reject(new Error("JSONP request failed: " + action));
      };

      timeout = setTimeout(function() {
        try {
          delete window[callbackName];
        } catch (err) {
          window[callbackName] = null;
        }

        if (script && script.parentNode) {
          script.parentNode.removeChild(script);
        }

        reject(new Error("JSONP timeout: " + action));
      }, 15000);

      script.src = GAS_URL + "?" + buildQuery(params);
      document.body.appendChild(script);

      console.log("[FriendRank JSONP]", action, params, script.src);
    });
  }

  function getBadgeClass(position) {
    if (position === 1) return "gold";
    if (position === 2) return "silver";
    if (position === 3) return "bronze";
    return "normal";
  }

  function getBadgeIcon(position) {
    if (position === 1) return "🥇";
    if (position === 2) return "🥈";
    if (position === 3) return "🥉";
    return position;
  }

  function getCleanGameBaseUrl() {
    return "https://liff.line.me/" + GAME_LIFF_ID;
  }

  function normalizeUserId(value) {
    return String(value || "").trim();
  }

  function isSameUser(row) {
    if (!row) return false;

    var rowUserId =
      row.userId ||
      row.lineUserId ||
      row.id ||
      row.uid ||
      row.playerId ||
      "";

    return normalizeUserId(rowUserId) &&
      normalizeUserId(rowUserId) === normalizeUserId(myUserId);
  }

  function getProfileParams() {
    return {
      userId: myUserId,
      lineUserId: myUserId,
      ownerLineUserId: myUserId,

      displayName: myPlayerName,
      playerName: myPlayerName,
      name: myPlayerName,

      pictureUrl: myPictureUrl,
      avatar: myPictureUrl,
      avatarUrl: myPictureUrl,

      referralCode: myReferralCode || "",
      ownerReferralCode: myReferralCode || "",
      inviterCode: myReferralCode || ""
    };
  }

  function saveLocalProfile() {
    try {
      var profile = {
        id: myUserId,
        userId: myUserId,
        lineUserId: myUserId,
        name: myPlayerName || "你",
        displayName: myPlayerName || "你",
        playerName: myPlayerName || "你",
        pictureUrl: myPictureUrl || "",
        referralCode: myReferralCode || "",
        isMe: true
      };

      localStorage.setItem("zg_profile", JSON.stringify(profile));
      localStorage.setItem("ZELO_PROFILE", JSON.stringify(profile));
      localStorage.setItem("zelo_liff_profile", JSON.stringify(profile));

      if (myReferralCode) {
        localStorage.setItem("zg_referral_code", myReferralCode);
        localStorage.setItem("ZELO_REFERRAL_CODE", myReferralCode);
      }
    } catch (err) {}
  }

  function updateDebug() {
    var inviteLink = buildInviteLink();

    setDebug(
      "<strong>userId:</strong> " + escapeHtml(myUserId || "-") +
      "<br><strong>referralCode:</strong> " + escapeHtml(myReferralCode || "-") +
      "<br><strong>邀請連結:</strong> " + escapeHtml(inviteLink)
    );
  }

  // ============================================================
  // 分享
  // ============================================================

  function buildInviteLink() {
    /*
     * 優先使用主遊戲 / GAS 的 ZG_xxxx referralCode。
     * 沒有時才 fallback LINE userId。
     */
    var inviterKey = myReferralCode || myUserId || "";

    var params = {
      ref: inviterKey,
      invite: inviterKey,
      referralCode: inviterKey,
      ownerReferralCode: inviterKey,

      inviterId: myUserId || "",
      inviter: myUserId || "",
      fromUserId: myUserId || "",
      referrerId: myUserId || "",
      ownerLineUserId: myUserId || "",

      inviterName: myPlayerName || "",
      refName: myPlayerName || "",
      referrerName: myPlayerName || "",

      inviterPictureUrl: myPictureUrl || "",
      refPictureUrl: myPictureUrl || "",
      referrerPictureUrl: myPictureUrl || "",

      source: "friend_rank_liff_share"
    };

    /*
     * LIFF 最穩作法：
     * 放進 liff.state，避免 LINE LIFF 中途吃掉 query。
     */
    var statePath = "/?" + buildQuery(params);

    return getCleanGameBaseUrl() +
      "?liff.state=" +
      encodeURIComponent(statePath);
  }

  function shareInviteLink() {
    var link = buildInviteLink();

    var shareText =
      "🎮 一起來玩 ZELO 陀螺挑戰賽！\n\n" +
      "用我的連結加入，看看誰的分數更高：\n" +
      link;

    if (
      typeof liff !== "undefined" &&
      typeof liff.isLoggedIn === "function" &&
      !liff.isLoggedIn()
    ) {
      liff.login({
        redirectUri: window.location.href
      });

      return;
    }

    if (
      typeof liff !== "undefined" &&
      typeof liff.shareTargetPicker === "function" &&
      (
        typeof liff.isApiAvailable !== "function" ||
        liff.isApiAvailable("shareTargetPicker")
      )
    ) {
      liff.shareTargetPicker([
        {
          type: "text",
          text: shareText
        }
      ]).then(function(result) {
        if (result) {
          showToast("✅ 已送出 LINE 邀請");
        } else {
          showToast("尚未送出邀請");
        }
      }).catch(function(err) {
        console.error("分享失敗", err);
        copyInviteLink(link);
      });

      return;
    }

    copyInviteLink(link);
  }

  function copyInviteLink(link) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(link).then(function() {
        showToast("✅ 邀請連結已複製！");
      }).catch(function() {
        fallbackCopy(link);
      });

      return;
    }

    fallbackCopy(link);
  }

  function fallbackCopy(text) {
    try {
      var input = document.createElement("textarea");
      input.value = text;
      input.style.position = "fixed";
      input.style.left = "-9999px";
      document.body.appendChild(input);
      input.focus();
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
      showToast("✅ 邀請連結已複製！");
    } catch (err) {
      showToast("請手動複製連結");
      window.prompt("請複製邀請連結", text);
    }
  }

  // ============================================================
  // 畫面渲染
  // ============================================================

  function extractRows(data) {
    data = data || {};

    var rows =
      data.friends ||
      data.rows ||
      data.friendRank ||
      data.rank ||
      data.leaderboard ||
      [];

    if (!Array.isArray(rows) && data.data && Array.isArray(data.data)) {
      rows = data.data;
    }

    if (!Array.isArray(rows) && data.data) {
      rows =
        data.data.friends ||
        data.data.rows ||
        data.data.friendRank ||
        data.data.rank ||
        data.data.leaderboard ||
        [];
    }

    if (!Array.isArray(rows)) {
      rows = [];
    }

    return rows;
  }

  function normalizeRows(rows) {
    rows = Array.isArray(rows) ? rows : [];

    return rows.map(function(row, index) {
      row = row || {};

      var userId =
        row.userId ||
        row.lineUserId ||
        row.id ||
        row.uid ||
        row.playerId ||
        "";

      var score =
        row.bestScore ||
        row.score ||
        row.maxScore ||
        row.highScore ||
        row.totalScore ||
        0;

      var position =
        Number(row.position || row.rank || index + 1) || index + 1;

      var isMe =
        !!row.isMe ||
        normalizeUserId(userId) === normalizeUserId(myUserId);

      return Object.assign({}, row, {
        userId: userId,
        position: position,
        score: Number(score || 0),
        bestScore: Number(row.bestScore || score || 0),
        isMe: isMe
      });
    }).sort(function(a, b) {
      var ap = Number(a.position || 999999);
      var bp = Number(b.position || 999999);

      if (ap !== bp) return ap - bp;

      return Number(b.bestScore || b.score || 0) -
        Number(a.bestScore || a.score || 0);
    });
  }

  function renderLeaderboard(data) {
    data = data || {};

    var rows = normalizeRows(extractRows(data));

    var totalFriends =
      data.totalFriends ||
      data.friendCount ||
      data.count ||
      rows.length ||
      0;

    document.getElementById("friend-count").textContent = totalFriends;

    var myEntry = null;

    for (var i = 0; i < rows.length; i++) {
      if (rows[i].isMe || isSameUser(rows[i])) {
        myEntry = rows[i];
        rows[i].isMe = true;
        break;
      }
    }

    document.getElementById("my-rank-text").innerHTML =
      "我的排名 <b>#" + (myEntry ? myEntry.position || myEntry.rank : "-") + "</b>";

    var listEl = document.getElementById("rank-list");

    if (!rows || rows.length === 0) {
      listEl.innerHTML =
        '<div class="empty-state"><div class="icon">👥</div>還沒有好友資料<br>快邀請朋友一起玩吧！</div>';
      return;
    }

    listEl.innerHTML = "";

    rows.forEach(function(f, index) {
      var position = Number(f.position || f.rank || index + 1);
      var bestRank = String(f.bestRank || f.rankTag || f.rankLabel || "");
      var rankClass = ["S", "A", "B"].indexOf(bestRank) !== -1 ? bestRank : "none";
      var rankLabel = bestRank || "-";
      var pictureUrl = f.pictureUrl || f.avatar || f.avatarUrl || "";
      var playerName =
        f.playerName ||
        f.displayName ||
        f.name ||
        f.userId ||
        "玩家";

      var avatarHtml = pictureUrl
        ? '<img class="avatar show" src="' + escapeHtml(pictureUrl) + '" alt="">'
        : '<img class="avatar" alt="">';

      var item = document.createElement("div");
      item.className = "rank-item" + (f.isMe ? " me" : "");

      item.innerHTML =
        '<div class="rank-badge ' + getBadgeClass(position) + '">' + getBadgeIcon(position) + '</div>' +
        avatarHtml +
        '<div class="player-info">' +
          '<div class="player-name">' +
            escapeHtml(playerName) +
            (f.isMe ? '<span class="me-tag">我</span>' : '') +
          '</div>' +
          '<div class="player-score">最高分紀錄</div>' +
        '</div>' +
        '<span class="rank-tag ' + rankClass + '">' + escapeHtml(rankLabel) + '</span>' +
        '<div class="score-value">' + escapeHtml(f.bestScore || f.score || 0) + '</div>';

      listEl.appendChild(item);
    });
  }

  function renderRewardProgress(inviteCount, tierName) {
    inviteCount = Number(inviteCount || 0);

    document.getElementById("tier-name").textContent =
      tierName || "尚未解鎖";

    var pct = Math.min(inviteCount / 5 * 100, 100);
    document.getElementById("progress-fill").style.width = pct + "%";

    [
      { id: "node-1", need: 1 },
      { id: "node-3", need: 3 },
      { id: "node-5", need: 5 }
    ].forEach(function(item) {
      var el = document.getElementById(item.id);

      if (!el) return;

      if (inviteCount >= item.need) {
        el.classList.add("unlocked");
      } else {
        el.classList.remove("unlocked");
      }
    });
  }

  // ============================================================
  // 資料載入
  // ============================================================

  function loadMyReferralCode() {
    /*
     * 優先詢問 GAS：這個 LINE userId 對應的 ZG_xxxx 是什麼。
     * 如果 GAS 尚未支援 get_liff_referral_code，就 fallback myUserId。
     */
    return jsonp("get_liff_referral_code", {
      userId: myUserId,
      lineUserId: myUserId,
      ownerLineUserId: myUserId,
      displayName: myPlayerName,
      playerName: myPlayerName,
      pictureUrl: myPictureUrl
    }).then(function(data) {
      data = data || {};
      lastReferralCodeRaw = data;

      myReferralCode =
        data.referralCode ||
        data.code ||
        data.myReferralCode ||
        data.ownerReferralCode ||
        data.inviteCode ||
        "";

      if (!myReferralCode) {
        myReferralCode = myUserId || "";
      }

      saveLocalProfile();

      console.log("[FriendRank] referralCode result", data, myReferralCode);

      return data;
    }).catch(function(err) {
      console.warn("get_liff_referral_code 載入失敗，改用 LINE userId", err);

      myReferralCode = myUserId || "";
      saveLocalProfile();

      return null;
    });
  }

  function loadInviteStatus() {
    var params = getProfileParams();

    params.referralCode = myReferralCode || "";
    params.ownerReferralCode = myReferralCode || "";
    params.inviterCode = myReferralCode || "";
    params.ownerLineUserId = myUserId || "";

    /*
     * 優先使用主遊戲 GAS action。
     */
    return jsonp("get_liff_referral_count", params).then(function(data) {
      data = data || {};
      lastInviteStatusRaw = data;

      var count =
        data.invitedCount ||
        data.count ||
        data.referralCount ||
        data.lineInviteFriendCount ||
        data.totalFriends ||
        0;

      var tierName = "尚未解鎖";

      if (count >= 5) {
        tierName = "🥇 5人獎勵已解鎖";
      } else if (count >= 3) {
        tierName = "🥈 3人獎勵已解鎖";
      } else if (count >= 1) {
        tierName = "🥉 1人獎勵已解鎖";
      }

      renderRewardProgress(count, tierName);

      console.log("[FriendRank] get_liff_referral_count result", data);

      return data;
    }).catch(function(err) {
      console.warn("get_liff_referral_count 失敗，改用 inviteStatus", err);

      /*
       * fallback：如果舊 GAS 有 inviteStatus 就用它。
       */
      return jsonp("inviteStatus", params).then(function(data) {
        data = data || {};
        lastInviteStatusRaw = data;

        var rewards = data.rewards || [];
        var unlockedTier = null;

        for (var i = rewards.length - 1; i >= 0; i--) {
          if (rewards[i].unlocked) {
            unlockedTier = rewards[i];
            break;
          }
        }

        renderRewardProgress(
          data.invitedCount ||
            data.count ||
            data.referralCount ||
            data.lineInviteFriendCount ||
            0,
          unlockedTier ? unlockedTier.reward : "尚未解鎖"
        );

        console.log("[FriendRank] inviteStatus fallback result", data);

        return data;
      }).catch(function(error) {
        console.error("邀請進度載入失敗", error);
        renderRewardProgress(0, "尚未解鎖");
        return null;
      });
    });
  }

  function loadLeaderboard() {
    var params = getProfileParams();

    params.referralCode = myReferralCode || "";
    params.ownerReferralCode = myReferralCode || "";
    params.inviterCode = myReferralCode || "";
    params.ownerLineUserId = myUserId || "";

    return jsonp("friendRank", params).then(function(data) {
      lastFriendRankRaw = data;
      console.log("[FriendRank] friendRank result", data);
      renderLeaderboard(data || {});
      return data;
    }).catch(function(err) {
      console.error("friendRank 載入失敗", err);

      document.getElementById("rank-list").innerHTML =
        '<div class="empty-state"><div class="icon">⚠️</div>載入失敗，請稍後再試</div>';

      return null;
    });
  }

  // ============================================================
  // LIFF 初始化
  // ============================================================

  function initPage() {
    setLoadingText("正在連接 LINE...");

    if (typeof liff === "undefined") {
      document.getElementById("loading").innerHTML =
        '<div class="empty-state"><div class="icon">⚠️</div>LIFF SDK 載入失敗，請稍後再試</div>';
      return;
    }

    liff.init({
      liffId: LIFF_ID
    }).then(function() {
      if (!liff.isLoggedIn()) {
        setLoadingText("請登入 LINE 後查看排行榜...");

        liff.login({
          redirectUri: window.location.href
        });

        return null;
      }

      setLoadingText("正在讀取 LINE 個人資料...");
      return liff.getProfile();
    }).then(function(profile) {
      if (!profile) return;

      myUserId = profile.userId || "";
      myPlayerName = profile.displayName || "你";
      myPictureUrl = profile.pictureUrl || "";

      if (!myUserId) {
        throw new Error("無法取得 LINE userId");
      }

      saveLocalProfile();

      setLoadingText("正在取得邀請碼...");

      return loadMyReferralCode().then(function() {
        setLoadingText("正在載入排行榜...");

        return Promise.all([
          loadLeaderboard(),
          loadInviteStatus()
        ]);
      });
    }).then(function() {
      if (!myUserId) return;

      document.getElementById("loading").style.display = "none";
      document.getElementById("main-content").style.display = "block";

      updateDebug();

      /*
       * 暴露 debug 資料，方便手機 WebView 或桌機測試。
       */
      window.ZELO_FRIEND_RANK_DEBUG = {
        gasUrl: GAS_URL,
        liffId: LIFF_ID,
        gameLiffId: GAME_LIFF_ID,
        userId: myUserId,
        displayName: myPlayerName,
        pictureUrl: myPictureUrl,
        referralCode: myReferralCode,
        inviteLink: buildInviteLink(),
        referralCodeRaw: lastReferralCodeRaw,
        friendRankRaw: lastFriendRankRaw,
        inviteStatusRaw: lastInviteStatusRaw
      };

      console.log("[FriendRank DEBUG]", window.ZELO_FRIEND_RANK_DEBUG);
    }).catch(function(err) {
      console.error("LIFF init failed", err);

      document.getElementById("loading").innerHTML =
        '<div class="empty-state"><div class="icon">⚠️</div>初始化失敗<br>請確認是否在 LINE 中開啟此頁面</div>';
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }
</script>

