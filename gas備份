  "me-local",       // 允許測試身份
  "dev-tester-001"
];

const IS_DEV_MODE = false; // 🔴 正式上線前務必改成 false，並移除或註解這段判斷

function isValidUserId(userId) {
  if (IS_DEV_MODE && DEV_MODE_ALLOWED_USER_IDS.includes(userId)) {
    return true;
  }

  // 正式驗證邏輯：真實 LINE userId 通常是 "U" 開頭 + 32 碼英數字
  return /^U[0-9a-f]{32}$/.test(userId);
}

