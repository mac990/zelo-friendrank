/**
 * 好友排行榜主邏輯。
 *
 * 邀請關係：沿用邀請關係表。
 * 分數來源：Players.totalScore。
 */
function getFriendRankDataByQuery_(query) {
  query = query || {};

  var lineUserId = normalizeString_(
    query.lineUserId ||
    query.userId ||
    query.ownerLineUserId ||
    ""
  );

  var referralCode = normalizeReferralCode_(
    query.ownerReferralCode ||
    query.myReferralCode ||
    query.referralCode ||
    ""
  );

  var friendIds = {};

  if (lineUserId) {
    friendIds[lineUserId] = true;
  }

  var myCodes = {};

  if (referralCode) {
    myCodes[referralCode] = true;
  }

  if (lineUserId) {
    myCodes[lineUserId] = true;
  }

  var refSheet = getReferralSheet_();
  var lastRow = refSheet.getLastRow();

  if (lastRow > 1) {
    var refData = refSheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();

    for (var i = 0; i < refData.length; i++) {
      var inviterCode0 = normalizeString_(refData[i][1]);
      var referredCode0 = normalizeString_(refData[i][2]);
      var referredUserId0 = normalizeString_(refData[i][3]);

      /*
       * 如果我提供的 LINE userId 曾經作為 referredUserId，
       * 取得我的 ZG referral code。
       */
      if (lineUserId && referredUserId0 === lineUserId && referredCode0) {
        myCodes[referredCode0] = true;
      }

      /*
       * 如果我提供的 referralCode 曾經作為 referredReferralCode，
       * 也納入。
       */
      if (referralCode && referredCode0 === referralCode) {
        myCodes[referredCode0] = true;

        if (referredUserId0) {
          friendIds[referredUserId0] = true;
        }
      }

      /*
       * 如果 inviter 是我自己的 LINE userId 或 referralCode，也納入自己的 code。
       */
      if (lineUserId && inviterCode0 === lineUserId) {
        myCodes[inviterCode0] = true;
      }

      if (referralCode && inviterCode0 === referralCode) {
        myCodes[inviterCode0] = true;
      }
    }

    for (var j = 0; j < refData.length; j++) {
      var inviterCode = normalizeString_(refData[j][1]);
      var inviteeCode = normalizeString_(refData[j][2]);
      var inviteeUserId = normalizeString_(refData[j][3]);

      var inviteeId = inviteeUserId || inviteeCode;

      /*
       * 我邀請出去的人。
       */
      if (myCodes[inviterCode] && inviteeId) {
        friendIds[inviteeId] = true;
      }

      /*
       * 邀請我的人。
       * 若 inviter 是 ZG_xxx，不能當成 userId 查分數；
       * 但如果不是 ZG_xxx，可加入 friendIds。
       */
      if (
        (inviteeUserId && lineUserId && inviteeUserId === lineUserId) ||
        (inviteeCode && referralCode && inviteeCode === referralCode)
      ) {
        if (inviterCode && String(inviterCode).indexOf("ZG_") !== 0) {
          friendIds[inviterCode] = true;
        }
      }
    }
  }

  /*
   * 分數來源改為 Players.totalScore。
   */
  var bestScores = getScoresForUsersFromPlayers_(Object.keys(friendIds));
  var friendList = [];

  for (var uid in bestScores) {
    if (bestScores.hasOwnProperty(uid)) {
      friendList.push({
        userId: uid,
        lineUserId: uid,

        playerName: bestScores[uid].playerName,
        displayName: bestScores[uid].playerName,
        name: bestScores[uid].playerName,

        bestScore: bestScores[uid].bestScore,
        totalScore: bestScores[uid].totalScore,
        score: bestScores[uid].totalScore,
        points: bestScores[uid].totalScore,

        bestRank: bestScores[uid].bestRank,

        pictureUrl: bestScores[uid].pictureUrl || "",
        avatar: bestScores[uid].pictureUrl || "",
        avatarUrl: bestScores[uid].pictureUrl || "",

        isMe: !!lineUserId && uid === lineUserId,
        me: !!lineUserId && uid === lineUserId
      });
    }
  }

  /*
   * 若前端帶了本次 totalScore，且 Players 尚未讀到，
   * 可以用本次分數補齊自己這列。
   * 但不再接受前端分數覆蓋 Players 實際分數。
   */
  var currentScore = toScoreNumber_(
    query.totalScore ||
    query.currentScore ||
    query.newScore ||
    query.score ||
    query.myScore ||
    0
  );

  if (lineUserId && currentScore > 0) {
    var foundMe = false;

    for (var m = 0; m < friendList.length; m++) {
      if (friendList[m].userId === lineUserId || friendList[m].lineUserId === lineUserId) {
        foundMe = true;

        if (Number(friendList[m].totalScore || 0) <= 0) {
          friendList[m].bestScore = currentScore;
          friendList[m].totalScore = currentScore;
          friendList[m].score = currentScore;
          friendList[m].points = currentScore;
        }

        if (query.playerName || query.displayName) {
          var name = normalizeString_(query.playerName || query.displayName);
          friendList[m].playerName = name;
          friendList[m].displayName = name;
          friendList[m].name = name;
        }

        if (query.pictureUrl) {
          friendList[m].pictureUrl = String(query.pictureUrl || "");
          friendList[m].avatar = String(query.pictureUrl || "");
          friendList[m].avatarUrl = String(query.pictureUrl || "");
        }

        friendList[m].isMe = true;
        friendList[m].me = true;
      }
    }

    if (!foundMe) {
      var myName = normalizeString_(query.playerName || query.displayName || lineUserId);

      friendList.push({
        userId: lineUserId,
        lineUserId: lineUserId,

        playerName: myName,
        displayName: myName,
        name: myName,

        bestScore: currentScore,
        totalScore: currentScore,
        score: currentScore,
        points: currentScore,

        bestRank: calculateGameRank_(currentScore),

        pictureUrl: normalizeString_(query.pictureUrl || ""),
        avatar: normalizeString_(query.pictureUrl || ""),
        avatarUrl: normalizeString_(query.pictureUrl || ""),

        isMe: true,
        me: true
      });
    }
  }

  friendList.sort(function(a, b) {
    if (Number(b.totalScore || 0) !== Number(a.totalScore || 0)) {
      return Number(b.totalScore || 0) - Number(a.totalScore || 0);
    }

    if (a.isMe && !b.isMe) return -1;
    if (!a.isMe && b.isMe) return 1;

    return String(a.playerName || "").localeCompare(String(b.playerName || ""));
  });

  for (var k = 0; k < friendList.length; k++) {
    friendList[k].position = k + 1;
    friendList[k].rank = k + 1;
  }

  var rows = friendList.map(function(item) {
    return {
      rank: item.position,
      position: item.position,

      userId: item.userId,
      lineUserId: item.lineUserId,

      name: item.name,
      playerName: item.playerName,
      displayName: item.displayName,

      score: item.totalScore,
      points: item.totalScore,
      bestScore: item.bestScore,
      totalScore: item.totalScore,

      bestRank: item.bestRank,

      pictureUrl: item.pictureUrl,
      avatar: item.avatar,
      avatarUrl: item.avatarUrl,

      isMe: item.isMe,
      me: item.me
    };
  });

  var inviteCount = 0;
  var myCodeKeys = Object.keys(myCodes);

  for (var c = 0; c < myCodeKeys.length; c++) {
    inviteCount = Math.max(inviteCount, countReferralByOwnerCode_(myCodeKeys[c]));
  }

  return {
    ok: true,

    myUserId: lineUserId,
    userId: lineUserId,
    lineUserId: lineUserId,
    referralCode: referralCode,

    lookup: {
      lineUserId: lineUserId,
      referralCode: referralCode,
      myCodes: myCodeKeys,
      friendIds: Object.keys(friendIds)
    },

    totalFriends: Math.max(0, friendList.length - 1),

    friends: friendList,
    rows: rows,
    friendRank: rows,
    rank: rows,

    lineInviteFriendCount: inviteCount,
    referralCount: inviteCount,
    successCount: inviteCount,
    count: inviteCount,

    version: GAS_VERSION
  };
}


