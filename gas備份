function getShopifyAccessToken_() {
  try {
    return PropertiesService
      .getScriptProperties()
      .getProperty("SHOPIFY_ACCESS_TOKEN") || SHOPIFY_ACCESS_TOKEN || "";
  } catch (err) {
    return SHOPIFY_ACCESS_TOKEN || "";
  }
}

function syncCouponUsage() {
  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return;

  var couponRange = sheet.getRange(2, 16, lastRow - 1, 1);
  var coupons = couponRange.getValues();
  var usedSet = fetchShopifyUsedDiscountCodes();

  var usedFlags = [];

  for (var i = 0; i < coupons.length; i++) {
    var code = String(coupons[i][0] || "").trim().toUpperCase();
    usedFlags.push([code && usedSet[code] ? "已使用" : ""]);
  }

  sheet.getRange(2, 21, usedFlags.length, 1).setValues(usedFlags);
}

function fetchShopifyUsedDiscountCodes() {
  var usedSet = {};
  var token = getShopifyAccessToken_();

  if (
    !SHOPIFY_STORE ||
    !token ||
    token === "請填入你的 Shopify Access Token"
  ) {
    return usedSet;
  }

  var url = "https://" + SHOPIFY_STORE + "/admin/api/2024-01/orders.json?status=any&limit=250&fields=id,discount_codes";
  var headers = {
    "X-Shopify-Access-Token": token
  };

  var guard = 0;

  while (url && guard < 20) {
    guard++;

    var response = UrlFetchApp.fetch(url, {
      headers: headers,
      muteHttpExceptions: true
    });

    var json = JSON.parse(response.getContentText());
    var orders = json.orders || [];

    for (var i = 0; i < orders.length; i++) {
      var codes = orders[i].discount_codes || [];

      for (var j = 0; j < codes.length; j++) {
        var codeStr = String(codes[j].code || "").trim().toUpperCase();

        if (codeStr) {
          usedSet[codeStr] = true;
        }
      }
    }

    var respHeaders = response.getHeaders();
    var linkHeader = respHeaders["Link"] || respHeaders["link"];
    url = null;

    if (linkHeader) {
      var match = linkHeader.match(/<([^>]+)>;\s*rel="next"/);

      if (match) {
        url = match[1];
      }
    }
  }

  return usedSet;
}

function testSyncCouponUsage() {
  syncCouponUsage();
}


