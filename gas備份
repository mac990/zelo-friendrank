/**
 * 安全排行榜分數來源：
 * 從 Players.totalScore 讀。
 */
function getScoresForUsersFromPlayers_(userIds) {
  var result = {};
  var idSet = {};

  userIds = userIds || [];

  for (var i = 0; i < userIds.length; i++) {
    var uid = normalizeString_(userIds[i]);

    if (uid) {
      idSet[uid] = true;
    }
  }

  var sheet = getPlayerSheet_();
  ensureGenericHeader_(sheet, PLAYER_HEADERS);

  var lastRow = sheet.getLastRow();

  if (lastRow > 1) {
    var values = sheet.getDataRange().getValues();
    var header = values[0];
    var index = headerIndexMap_(header);

    for (var r = 1; r < values.length; r++) {
      var row = values[r];

      var uid2 = normalizeString_(row[index.userId]);
      if (!uid2 || !idSet[uid2]) continue;

      var totalScore = toScoreNumber_(row[index.totalScore]);

      result[uid2] = {
        playerName: normalizeString_(row[index.displayName]) || uid2,
        bestScore: totalScore,
        totalScore: totalScore,
        bestRank: calculateGameRank_(totalScore),
        pictureUrl: normalizeString_(row[index.pictureUrl])
      };
    }
  }

  /*
   * 所有好友都要有一列，即使還沒玩過。
   */
  for (var uid3 in idSet) {
    if (idSet.hasOwnProperty(uid3) && !result[uid3]) {
      result[uid3] = {
        playerName: lookupPlayerNameByUserId(uid3) || uid3,
        bestScore: 0,
        totalScore: 0,
        bestRank: "",
        pictureUrl: ""
      };
    }
  }

  return result;
}


/**
 * 舊版最高分掃描保留。
 * 目前不作為 friendRank 主要分數來源。
 * 可給 Dashboard 或舊測試使用。
 */
function getBestScoresForUsers(userIds) {
