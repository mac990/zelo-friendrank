// 八之三、安全戰鬥結算主邏輯
// ============================================================



/*
 * 依照後端驗證出的戰鬥結果，計算本場應得的 ZELO Points。
 * 找不到對應結果時，保守回傳 0，不憑空給點數。
 */
/*
 * =========================================================
 * 【升級版】戰鬥結算 ZELO Points 計算邏輯
 * =========================================================
 *
 * 完整對齊前端 calculateRewardPointsGain() 的 5 項加成規則，
 * 但所有數值都由「後端已驗證過的資料」重新計算，
 * 不採信前端傳來的 zeloPointsGain / rewardPoints 等欄位。
 *
 * 加成項目：
 * 1. 基礎分：+5（固定）
 * 2. 結果加成：win +15 / draw +8 / lose +3
 *    → 來源：verified.result（後端重新驗證過的戰鬥結果，無法偽造）
 * 3. 完美發射加成：+5
 *    → 來源：payload.launchGrade（前端傳入，目前無獨立驗證機制，
 *      風險可控，因為金額小且有 MIN_BATTLE_INTERVAL_MS 冷卻限制）
 * 4. 能量加成：+5（我方能量 >= 50）
 *    → 來源：verified.myEnergy（後端重新驗證過，無法偽造）
 * 5. 每日首場加成：+10
 *    → 來源：isFirstBattleToday（依 DailyScoreLogs.battleCount 判斷，
 *      無法偽造，只能真正的當天第一場才會觸發）
 *
 * params: {
 *   result: "win" | "lose" | "draw",
 *   myEnergy: number,
 *   launchGrade: string,
 *   isFirstBattleToday: boolean
 * }
 */
function calcZeloPointsForBattle_(params) {
  params = params || {};

  var gain = 5;

  var resultType = params.result || "draw";

  if (resultType === "win") {
    gain += 15;
  } else if (resultType === "draw") {
    gain += 8;
  } else {
    gain += 3;
  }

  var launchGrade = sanitizeText_(params.launchGrade || "", 40);

  if (launchGrade === "perfect") {
    gain += 5;
  }

  var playerEnergy = Number(params.myEnergy || 0);

  if (playerEnergy >= 50) {
    gain += 5;
  }

  if (params.isFirstBattleToday) {
    gain += 10;
  }

  return gain;
}

function recordBattleResult(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      message: "系統忙碌中，請稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var playersSheet = getPlayerSheet_();
    var battleLogsSheet = getBattleLogSheet_();
    var dailySheet = getDailyScoreLogSheet_();

    var now = new Date();
    var nowMs = now.getTime();

    var userId = normalizeUserIdFromPayload_(payload);
    var battleId = normalizeBattleIdFromPayload_(payload);

    var displayName = sanitizeText_(
      payload.displayName ||
      payload.playerName ||
      payload.name ||
      payload.nickname ||
      "玩家",
      60
    );

    var pictureUrl = sanitizeText_(
      payload.pictureUrl ||
      payload.avatar ||
      payload.avatarUrl ||
      "",
      500
    );

    var referralCode = normalizeReferralCode_(
      payload.referralCode ||
      payload.myReferralCode ||
      payload.ownerReferralCode ||
      ""
    );

    /*
     * me-local / guest / anonymous 不允許進正式積分。
     * 避免 LIFF 尚未登入時污染 Players / 排行榜。
     */
    if (
  !userId ||
  userId === "me-local" ||
  userId === "guest" ||
  userId === "anonymous" ||
  !isValidUserId(userId)
) {
  return {
    ok: false,
    code: "INVALID_USER_ID",
    result: "error",
    message: "缺少有效 LINE userId，未進行正式積分結算。",
    userId: userId,
    battleId: battleId,
    version: GAS_VERSION
  };
}


    if (!battleId) {
      return {
        ok: false,
        code: "MISSING_BATTLE_ID",
        result: "error",
        message: "缺少 battleId。",
        userId: userId,
        version: GAS_VERSION
      };
    }

    /*
     * 1. battleId 去重。
     * 同一 userId + battleId 只能結算一次。
     */
    if (battleIdAlreadyUsed_(battleLogsSheet, battleId, userId)) {
      var duplicatePlayerInfo = findOrCreatePlayer_(
        playersSheet,
        userId,
        displayName,
        pictureUrl,
        referralCode,
        now
      );

      /*
       * duplicate 也寫 BattleLogs，方便 Dashboard 統計防刷攔截。
       * delta 永遠 0，不會重複加扣分。
       */
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: 0,
          oldScore: duplicatePlayerInfo.player.totalScore,
          newScore: duplicatePlayerInfo.player.totalScore,

          myEnergy:
            payload.myEnergy !== undefined
              ? payload.myEnergy
              : payload.playerEnergy !== undefined
                ? payload.playerEnergy
                : payload.playerHp,

          enemyEnergy:
            payload.enemyEnergy !== undefined
              ? payload.enemyEnergy
              : payload.enemyHp,

          mySpeed:
            payload.mySpeed !== undefined
              ? payload.mySpeed
              : payload.playerSpin,

          enemySpeed:
            payload.enemySpeed !== undefined
              ? payload.enemySpeed
              : payload.enemySpin,

          clientTime: payload.clientTime,
          createdAt: now,
          reason: "DUPLICATE_BATTLE",
          raw: JSON.stringify(payload)
        }
      );

      var duplicateRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: duplicatePlayerInfo.player.totalScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var duplicateRows = limitRankRows_(
        duplicateRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "DUPLICATE_BATTLE",
        result: "ignored",
        message: "此局已經結算過，不能重複加分。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: duplicatePlayerInfo.player.totalScore,
        currentScore: duplicatePlayerInfo.player.totalScore,
        newScore: duplicatePlayerInfo.player.totalScore,
        score: duplicatePlayerInfo.player.totalScore,

        delta: 0,
        rawDelta: 0,
        reason: "DUPLICATE_BATTLE",

        friendRank: duplicateRows,
        rows: duplicateRows,
        rank: duplicateRows,

        myRank: findMyRankInRows_(duplicateRows, userId),
        myPosition: findMyRankInRows_(duplicateRows, userId),

        lineInviteFriendCount: duplicateRankResult.lineInviteFriendCount || 0,
        referralCount: duplicateRankResult.referralCount || 0,
        successCount: duplicateRankResult.successCount || 0,
        count: duplicateRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 2. 找或建立玩家。
     */
    var playerInfo = findOrCreatePlayer_(
      playersSheet,
      userId,
      displayName,
      pictureUrl,
      referralCode,
      now
    );

    var player = playerInfo.player;
    var playerRowIndex = playerInfo.rowIndex;

    /*
     * 【新增】陀螺持有權驗證。
     */
    var claimedTopId = sanitizeText_(
      payload.topId ||
      payload.selectedTopId ||
      payload.playerTopId ||
      "",
      100
    );

    if (claimedTopId && isSecretToyId_(claimedTopId)) {
      if (!playerOwnsToyId_(userId, claimedTopId)) {
        var oldScoreForBlock = clampNumber_(
          Number(player.totalScore || 0),
          MIN_TOTAL_SCORE,
          999999999
        );

        appendBattleLog_(
          battleLogsSheet,
          {
            battleId: battleId,
            userId: userId,
            displayName: displayName,
            result: "rejected",
            delta: 0,
            rawDelta: 0,
            oldScore: oldScoreForBlock,
            newScore: oldScoreForBlock,
            myEnergy: payload.myEnergy,
            enemyEnergy: payload.enemyEnergy,
            mySpeed: payload.mySpeed,
            enemySpeed: payload.enemySpeed,
            clientTime: payload.clientTime,
            createdAt: now,
            reason: "TOP_NOT_UNLOCKED",
            raw: JSON.stringify(payload)
          }
        );

        return {
          ok: false,
          code: "TOP_NOT_UNLOCKED",
          result: "rejected",
          message: "此陀螺尚未解鎖，無法用於對戰。",
          userId: userId,
          battleId: battleId,
          topId: claimedTopId,
          totalScore: oldScoreForBlock,
          version: GAS_VERSION
        };
      }
    }

    var oldScore = clampNumber_(
      Number(player.totalScore || 0),
      MIN_TOTAL_SCORE,
      999999999
    );

    /*
     * 3. 冷卻時間。
     */
    var lastBattleAtMs = player.lastBattleAt
      ? new Date(player.lastBattleAt).getTime()
      : 0;

    if (
      lastBattleAtMs &&
      nowMs - lastBattleAtMs < MIN_BATTLE_INTERVAL_MS
    ) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: 0,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: payload.myEnergy,
          enemyEnergy: payload.enemyEnergy,
          mySpeed: payload.mySpeed,
          enemySpeed: payload.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "TOO_FAST",
          raw: JSON.stringify(payload)
        }
      );

      var tooFastRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: oldScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var tooFastRows = limitRankRows_(
        tooFastRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "TOO_FAST",
        result: "rejected",
        message: "送出太快，請稍後再試。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: 0,
        reason: "TOO_FAST",

        friendRank: tooFastRows,
        rows: tooFastRows,
        rank: tooFastRows,

        myRank: findMyRankInRows_(tooFastRows, userId),
        myPosition: findMyRankInRows_(tooFastRows, userId),

        lineInviteFriendCount: tooFastRankResult.lineInviteFriendCount || 0,
        referralCount: tooFastRankResult.referralCount || 0,
        successCount: tooFastRankResult.successCount || 0,
        count: tooFastRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 4. 後端重新計算結果與 delta。
     */
    var verified = verifyBattleByServer_(payload);

    if (!ALLOWED_BATTLE_DELTAS[String(verified.delta)]) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: verified.myEnergy,
          enemyEnergy: verified.enemyEnergy,
          mySpeed: verified.mySpeed,
          enemySpeed: verified.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "INVALID_DELTA",
          raw: JSON.stringify(payload)
        }
      );

      return {
        ok: false,
        code: "INVALID_DELTA",
        result: "rejected",
        message: "分數異常，已拒絕結算。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: verified.delta,
        reason: "INVALID_DELTA",

        version: GAS_VERSION
      };
    }

    /*
     * 5. 每日記錄。
     */
    var dateKey = formatDateKey_(now);
    var dailyInfo = findOrCreateDailyLog_(
      dailySheet,
      dateKey,
      userId,
      now
    );

    /*
     * 5-1. 若開啟每日遊玩限制，超過則拒絕結算。
     */
    if (
      ENABLE_DAILY_PLAY_LIMIT_IN_RECORD &&
      Number(dailyInfo.daily.battleCount || 0) >= DAILY_PLAY_LIMIT
    ) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: verified.myEnergy,
          enemyEnergy: verified.enemyEnergy,
          mySpeed: verified.mySpeed,
          enemySpeed: verified.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "DAILY_PLAY_LIMIT_REACHED",
          raw: JSON.stringify(payload)
        }
      );

      var dailyLimitRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: oldScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var dailyLimitRows = limitRankRows_(
        dailyLimitRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "DAILY_PLAY_LIMIT_REACHED",
        result: "rejected",
        message: "今日遊玩次數已達上限。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: verified.delta,
        reason: "DAILY_PLAY_LIMIT_REACHED",

        playedToday: Number(dailyInfo.daily.battleCount || 0),
        limit: DAILY_PLAY_LIMIT,

        friendRank: dailyLimitRows,
        rows: dailyLimitRows,
        rank: dailyLimitRows,

        myRank: findMyRankInRows_(dailyLimitRows, userId),
        myPosition: findMyRankInRows_(dailyLimitRows, userId),

        lineInviteFriendCount: dailyLimitRankResult.lineInviteFriendCount || 0,
        referralCount: dailyLimitRankResult.referralCount || 0,
        successCount: dailyLimitRankResult.successCount || 0,
        count: dailyLimitRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 6. 每日正向加分上限。
     */
    var currentPositiveTotal = Number(
      dailyInfo.daily.positiveDeltaTotal || 0
    );

    var finalDelta = verified.delta;
    var reason = "OK";

    if (verified.delta > 0) {
      var remainingPositiveQuota =
        DAILY_POSITIVE_DELTA_LIMIT - currentPositiveTotal;

      if (remainingPositiveQuota <= 0) {
        finalDelta = 0;
        reason = "DAILY_POSITIVE_LIMIT_REACHED";
      } else if (verified.delta > remainingPositiveQuota) {
        finalDelta = remainingPositiveQuota;
        reason = "DAILY_POSITIVE_LIMIT_PARTIAL";
      }
    }

    /*
     * 7. 新總分。
     */
    var newScore = Math.max(
      MIN_TOTAL_SCORE,
      oldScore + finalDelta
    );

/*
 * 8. 更新 Players。
 *
 * 【升級】完整計算 5 項加成（基礎分／結果／完美發射／能量／每日首場），
 * 並套用每日 ZELO Points 上限，讓抽獎系統讀到的點數不再永遠是 0，
 * 同時防止異常刷分。
 * 給分規則完全由後端決定，不採信前端傳來的任何 zeloPointsGain / rewardPoints 欄位。
 */
var isFirstBattleToday = Number(dailyInfo.daily.battleCount || 0) === 0;

var rawZeloPointsGain = calcZeloPointsForBattle_({
  result: verified.result,
  myEnergy: verified.myEnergy,
  launchGrade: payload.launchGrade,
  isFirstBattleToday: isFirstBattleToday
});

/*
 * 套用每日 ZELO Points 上限，防止異常刷分。
 * 達上限後本場不再加 ZELO Points，但 score 排行榜分數仍正常結算。
 */
var currentZeloPointsToday = Number(dailyInfo.daily.zeloPointsToday || 0);
var remainingZeloQuota = DAILY_ZELO_POINTS_LIMIT - currentZeloPointsToday;

var zeloPointsDelta;

if (remainingZeloQuota <= 0) {
  zeloPointsDelta = 0;
} else {
  zeloPointsDelta = Math.min(rawZeloPointsGain, remainingZeloQuota);
}

var oldZeloPoints = Number(player.zeloPoints || 0);
var newZeloPoints = Math.max(0, oldZeloPoints + zeloPointsDelta);

updatePlayer_(
  playersSheet,
  playerRowIndex,
  {
    displayName: displayName,
    pictureUrl: pictureUrl,
    referralCode: referralCode,
    totalScore: newScore,
    lastBattleAt: now,
    updatedAt: now,

    /*
     * 把 ZELO Points 也一起寫回權威資料庫。
     */
    zeloPoints: newZeloPoints
  }
);

/*
 * 9. 更新 DailyScoreLogs。
 *
 * 【新增】同時記錄本日累積 ZELO Points，
 * 供下次結算判斷是否已達 DAILY_ZELO_POINTS_LIMIT。
 */
updateDailyLog_(
  dailySheet,
  dailyInfo.rowIndex,
  {
    positiveDeltaTotal:
      currentPositiveTotal + Math.max(0, finalDelta),
    battleCount: Number(dailyInfo.daily.battleCount || 0) + 1,
    updatedAt: now,
    zeloPointsToday: currentZeloPointsToday + Math.max(0, zeloPointsDelta)
  }
);

    /*
     * 10. 寫 BattleLogs。
     */
    appendBattleLog_(
      battleLogsSheet,
      {
        battleId: battleId,
        userId: userId,
        displayName: displayName,
        result: verified.result,
        delta: finalDelta,
        rawDelta: verified.delta,
        oldScore: oldScore,
        newScore: newScore,
        myEnergy: verified.myEnergy,
        enemyEnergy: verified.enemyEnergy,
        mySpeed: verified.mySpeed,
        enemySpeed: verified.enemySpeed,
        clientTime: payload.clientTime,
        createdAt: now,
        reason: reason,
        raw: JSON.stringify(payload)
      }
    );

    /*
     * 11. 寫原始資料。
     */
    try {
      appendSecureResultToRawLog_(
        payload,
        {
          userId: userId,
          displayName: displayName,
          pictureUrl: pictureUrl,
          referralCode: referralCode,
          battleId: battleId,
          verified: verified,
          delta: finalDelta,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: newScore,
          reason: reason,
          createdAt: now
        }
      );
    } catch (rawLogErr) {}

    /*
     * 12. 回傳好友排行榜。
     */
    var rankResult = getFriendRankDataByQuery_({
      userId: userId,
      lineUserId: userId,
      ownerReferralCode: referralCode,
      myReferralCode: referralCode,
      referralCode: referralCode,
      totalScore: newScore,
      displayName: displayName,
      playerName: displayName,
      pictureUrl: pictureUrl
    });

    var limitedRows = limitRankRows_(
      rankResult.rows || [],
      SECURE_FRIEND_RANK_LIMIT
    );

    var myRank = findMyRankInRows_(limitedRows, userId);

    return {
  ok: true,
  code: "OK",
  result: verified.result,
  message: "結算成功。",

  userId: userId,
  lineUserId: userId,
  battleId: battleId,

  battleResult: verified.result,

  delta: finalDelta,
  rawDelta: verified.delta,

  oldScore: oldScore,
  totalScore: newScore,
  currentScore: newScore,
  newScore: newScore,
  score: newScore,

  points: finalDelta,
  battlePoints: finalDelta,

  /*
   * 【新增】ZELO Points 結算結果，
   * 前端可以直接拿這個數字更新畫面，不用再猜。
   */
  zeloPointsDelta: zeloPointsDelta,
  zeloPointsGain: zeloPointsDelta,
  oldZeloPoints: oldZeloPoints,
  zeloPoints: newZeloPoints,
  zeloPointsTotal: newZeloPoints,

  reason: reason,

  dailyPositiveDeltaTotal:
    currentPositiveTotal + Math.max(0, finalDelta),
  dailyPositiveDeltaLimit: DAILY_POSITIVE_DELTA_LIMIT,
  playedToday: Number(dailyInfo.daily.battleCount || 0) + 1,

  friendRank: limitedRows,
  rows: limitedRows,
  rank: limitedRows,

  myRank: myRank,
  myPosition: myRank,

  lineInviteFriendCount: rankResult.lineInviteFriendCount || 0,
  referralCount: rankResult.referralCount || 0,
  successCount: rankResult.successCount || 0,
  count: rankResult.count || 0,

  version: GAS_VERSION
};
  } catch (error) {
    return {
      ok: false,
      code: "SERVER_ERROR",
      result: "error",
      message: String(error && error.message ? error.message : error),
      stack: String(error && error.stack ? error.stack : ""),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseErr) {}
  }
}


/**
 * 後端重新計算戰鬥結果。
 *
 * 目前規則：
 * - 我方能量 > 敵方能量：win，+60
 * - 我方能量 < 敵方能量：lose，-44
 * - 能量相同時比轉速
 * - 我方轉速 > 敵方轉速：win，+60
 * - 我方轉速 < 敵方轉速：lose，-44
 * - 完全相同：draw，+30
 */
function verifyBattleByServer_(payload) {
  payload = payload || {};

  var myEnergy = clampNumber_(
    payload.myEnergy !== undefined
      ? payload.myEnergy
      : payload.playerHp !== undefined
        ? payload.playerHp
        : payload.playerEnergy,
    0,
    100
  );

  var enemyEnergy = clampNumber_(
    payload.enemyEnergy !== undefined
      ? payload.enemyEnergy
      : payload.enemyHp !== undefined
        ? payload.enemyHp
        : payload.enemyEnergy,
    0,
    100
  );

  var mySpeed = clampNumber_(
    payload.mySpeed !== undefined
      ? payload.mySpeed
      : payload.playerSpeed !== undefined
        ? payload.playerSpeed
        : payload.speed,
    0,
    100
  );

  var enemySpeed = clampNumber_(
    payload.enemySpeed !== undefined
      ? payload.enemySpeed
      : payload.rivalSpeed,
    0,
    100
  );

  var result = "draw";
  var delta = 30;

  if (myEnergy > enemyEnergy) {
    result = "win";
    delta = 60;
  } else if (myEnergy < enemyEnergy) {
    result = "lose";
    delta = -44;
  } else if (mySpeed > enemySpeed) {
    result = "win";
    delta = 60;
  } else if (mySpeed < enemySpeed) {
    result = "lose";
    delta = -44;
  } else {
    result = "draw";
    delta = 30;
  }

  return {
    result: result,
    delta: delta,
    myEnergy: myEnergy,
    enemyEnergy: enemyEnergy,
    mySpeed: mySpeed,
    enemySpeed: enemySpeed
  };
}

