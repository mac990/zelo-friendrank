    };
  } catch (error) {
    return {
      ok: false,
      code: "SERVER_ERROR",
      result: "error",
      action: "gacha_draw",
      message: String(error && error.message ? error.message : error),
      stack: String(error && error.stack ? error.stack : ""),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseErr) {}
  }
}


function recordGachaClaim_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      action: "gacha_claim",
      message: "系統忙碌中，派發狀態稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var sheet = getGachaDrawSheet_();
    ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

    var drawId = sanitizeText_(
      payload.drawId ||
      (payload.draw && payload.draw.drawId) ||
      "",
      120
    );

    if (!drawId) {
      return {
        ok: false,
        code: "MISSING_DRAW_ID",
        result: "error",
        action: "gacha_claim",
        message: "缺少 drawId，無法更新派發狀態。",
        version: GAS_VERSION
      };
    }

    var claimStatus = sanitizeText_(
      payload.claimStatus ||
      (payload.draw && payload.draw.claimStatus) ||
      "claimed",
      60
    );

    var claimedAt = sanitizeText_(
      payload.claimedAt ||
      (payload.draw && payload.draw.claimedAt) ||
      Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss"),
      80
    );

    var claimedBy = sanitizeText_(
      payload.claimedBy ||
      (payload.draw && payload.draw.claimedBy) ||
      "admin",
      100
    );

    var claimNote = sanitizeText_(
      payload.claimNote ||
      (payload.draw && payload.draw.claimNote) ||
      "",
      300
    );

    var couponCode = sanitizeText_(
      payload.couponCode ||
      (payload.draw && payload.draw.couponCode) ||
      "",
      120
    );

    var lineNotifiedAt = sanitizeText_(
      payload.lineNotifiedAt ||
      (payload.draw && payload.draw.lineNotifiedAt) ||
      "",
      80
    );

    var lastRow = sheet.getLastRow();
    var lastCol = sheet.getLastColumn();

    if (lastRow < 2) {
      return {
        ok: false,
        code: "EMPTY_SHEET",
        result: "error",
        action: "gacha_claim",
        drawId: drawId,
        message: "GachaDraws 沒有資料列。",
        version: GAS_VERSION
      };
    }

    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    var colMap = {};

    headers.forEach(function (header, index) {
      if (header) {
        colMap[String(header)] = index + 1;
      }
    });

    var drawIdCol = colMap.drawId;
    var claimStatusCol = colMap.claimStatus;
    var claimedAtCol = colMap.claimedAt;
    var claimedByCol = colMap.claimedBy;
    var claimNoteCol = colMap.claimNote;
    var couponCodeCol = colMap.couponCode;
    var lineNotifiedAtCol = colMap.lineNotifiedAt;

    if (!drawIdCol) {
      return {
        ok: false,
        code: "MISSING_DRAW_ID_COLUMN",
        result: "error",
        action: "gacha_claim",
        message: "GachaDraws 缺少 drawId 欄位。",
        version: GAS_VERSION
      };
    }

    if (!claimStatusCol) {
      return {
        ok: false,
        code: "MISSING_CLAIM_COLUMNS",
        result: "error",
        action: "gacha_claim",
        message: "GachaDraws 缺少 claimStatus 欄位，請確認表頭已更新。",
        version: GAS_VERSION
      };
    }

    var drawIdValues = sheet.getRange(2, drawIdCol, lastRow - 1, 1).getValues();

    var targetRow = 0;

    for (var i = 0; i < drawIdValues.length; i++) {
      if (String(drawIdValues[i][0]) === String(drawId)) {
        targetRow = i + 2;
        break;
      }
    }

    if (!targetRow) {
      return {
        ok: false,
        code: "DRAW_NOT_FOUND",
        result: "error",
        action: "gacha_claim",
        drawId: drawId,
        message: "找不到指定 drawId 的扭蛋紀錄。",
        version: GAS_VERSION
      };
    }

    sheet.getRange(targetRow, claimStatusCol).setValue(claimStatus);

    if (claimedAtCol) {
      sheet.getRange(targetRow, claimedAtCol).setValue(claimedAt);
    }

    if (claimedByCol) {
      sheet.getRange(targetRow, claimedByCol).setValue(claimedBy);
    }

    if (claimNoteCol) {
      sheet.getRange(targetRow, claimNoteCol).setValue(claimNote);
    }

    if (couponCodeCol) {
      sheet.getRange(targetRow, couponCodeCol).setValue(couponCode);
    }

    if (lineNotifiedAtCol) {
      sheet.getRange(targetRow, lineNotifiedAtCol).setValue(lineNotifiedAt);
    }

    return {
      ok: true,
      code: "OK",
      result: "success",
      action: "gacha_claim",
      drawId: drawId,
      row: targetRow,
      claimStatus: claimStatus,
      claimedAt: claimedAt,
      claimedBy: claimedBy,
      couponCode: couponCode,
      lineNotifiedAt: lineNotifiedAt,
      version: GAS_VERSION
    };
  } catch (err) {
    return {
      ok: false,
      code: "GACHA_CLAIM_ERROR",
      result: "error",
      action: "gacha_claim",
      message: err && err.message ? err.message : String(err),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseError) {}
  }
}



function gachaDrawIdAlreadyUsed_(sheet, drawId) {
  if (!sheet || !drawId) return false;

  ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) return false;

  /*
   * GACHA_DRAW_HEADERS 第 3 欄是 drawId。
   * 只掃最近 5000 筆，避免分頁太大時變慢。
   */
  var checkRows = Math.min(lastRow - 1, 5000);
  var startRow = lastRow - checkRows + 1;

  var values = sheet
    .getRange(startRow, 3, checkRows, 1)
    .getValues();

  var targetDrawId = String(drawId || "");

  for (var i = values.length - 1; i >= 0; i--) {
    var oldDrawId = String(values[i][0] || "");

    if (oldDrawId === targetDrawId) {
      return true;
    }
  }

  return false;
}


function recordBattleResult(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      message: "系統忙碌中，請稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var playersSheet = getPlayerSheet_();
    var battleLogsSheet = getBattleLogSheet_();
    var dailySheet = getDailyScoreLogSheet_();

    var now = new Date();
    var nowMs = now.getTime();

    var userId = normalizeUserIdFromPayload_(payload);
    var battleId = normalizeBattleIdFromPayload_(payload);

    var displayName = sanitizeText_(
      payload.displayName ||
      payload.playerName ||
      payload.name ||
      payload.nickname ||
      "玩家",
      60
    );

    var pictureUrl = sanitizeText_(
      payload.pictureUrl ||
      payload.avatar ||
      payload.avatarUrl ||
      "",
      500
    );

    var referralCode = normalizeReferralCode_(
      payload.referralCode ||
      payload.myReferralCode ||
      payload.ownerReferralCode ||
      ""
    );

    /*
     * me-local / guest / anonymous 不允許進正式積分。
     * 避免 LIFF 尚未登入時污染 Players / 排行榜。
     */
    if (
      !userId ||
      userId === "me-local" ||
      userId === "guest" ||
      userId === "anonymous"
    ) {
      return {
        ok: false,
        code: "INVALID_USER_ID",
        result: "error",
        message: "缺少有效 LINE userId，未進行正式積分結算。",
        userId: userId,
        battleId: battleId,
        version: GAS_VERSION
      };
    }

    if (!battleId) {
      return {
        ok: false,
        code: "MISSING_BATTLE_ID",
        result: "error",
        message: "缺少 battleId。",
        userId: userId,
        version: GAS_VERSION
      };
    }

    /*
     * 1. battleId 去重。
     * 同一 userId + battleId 只能結算一次。
     */
    if (battleIdAlreadyUsed_(battleLogsSheet, battleId, userId)) {
      var duplicatePlayerInfo = findOrCreatePlayer_(
        playersSheet,
        userId,
        displayName,
        pictureUrl,
        referralCode,
        now
      );

      /*
       * duplicate 也寫 BattleLogs，方便 Dashboard 統計防刷攔截。
       * delta 永遠 0，不會重複加扣分。
       */
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: 0,
          oldScore: duplicatePlayerInfo.player.totalScore,
          newScore: duplicatePlayerInfo.player.totalScore,

          myEnergy:
            payload.myEnergy !== undefined
              ? payload.myEnergy
              : payload.playerEnergy !== undefined
                ? payload.playerEnergy
                : payload.playerHp,

          enemyEnergy:
            payload.enemyEnergy !== undefined
              ? payload.enemyEnergy
              : payload.enemyHp,

          mySpeed:
            payload.mySpeed !== undefined
              ? payload.mySpeed
              : payload.playerSpin,

          enemySpeed:
            payload.enemySpeed !== undefined
              ? payload.enemySpeed
              : payload.enemySpin,

          clientTime: payload.clientTime,
          createdAt: now,
          reason: "DUPLICATE_BATTLE",
          raw: JSON.stringify(payload)
        }
      );

      var duplicateRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: duplicatePlayerInfo.player.totalScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var duplicateRows = limitRankRows_(
        duplicateRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "DUPLICATE_BATTLE",
        result: "ignored",
        message: "此局已經結算過，不能重複加分。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: duplicatePlayerInfo.player.totalScore,
        currentScore: duplicatePlayerInfo.player.totalScore,
        newScore: duplicatePlayerInfo.player.totalScore,
        score: duplicatePlayerInfo.player.totalScore,

        delta: 0,
        rawDelta: 0,
        reason: "DUPLICATE_BATTLE",

        friendRank: duplicateRows,
        rows: duplicateRows,
        rank: duplicateRows,

        myRank: findMyRankInRows_(duplicateRows, userId),
        myPosition: findMyRankInRows_(duplicateRows, userId),

        lineInviteFriendCount: duplicateRankResult.lineInviteFriendCount || 0,
        referralCount: duplicateRankResult.referralCount || 0,
        successCount: duplicateRankResult.successCount || 0,
        count: duplicateRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 2. 找或建立玩家。
     */
    var playerInfo = findOrCreatePlayer_(
      playersSheet,
      userId,
      displayName,
      pictureUrl,
      referralCode,
      now
    );

    var player = playerInfo.player;
    var playerRowIndex = playerInfo.rowIndex;

    var oldScore = clampNumber_(
      Number(player.totalScore || 0),
      MIN_TOTAL_SCORE,
      999999999
    );

    /*
     * 3. 冷卻時間。
     */
    var lastBattleAtMs = player.lastBattleAt
      ? new Date(player.lastBattleAt).getTime()
      : 0;

    if (
      lastBattleAtMs &&
      nowMs - lastBattleAtMs < MIN_BATTLE_INTERVAL_MS
    ) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: 0,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: payload.myEnergy,
          enemyEnergy: payload.enemyEnergy,
          mySpeed: payload.mySpeed,
          enemySpeed: payload.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "TOO_FAST",
          raw: JSON.stringify(payload)
        }
      );

      var tooFastRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: oldScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var tooFastRows = limitRankRows_(
        tooFastRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "TOO_FAST",
        result: "rejected",
        message: "送出太快，請稍後再試。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: 0,
        reason: "TOO_FAST",

        friendRank: tooFastRows,
        rows: tooFastRows,
        rank: tooFastRows,

        myRank: findMyRankInRows_(tooFastRows, userId),
        myPosition: findMyRankInRows_(tooFastRows, userId),

        lineInviteFriendCount: tooFastRankResult.lineInviteFriendCount || 0,
        referralCount: tooFastRankResult.referralCount || 0,
        successCount: tooFastRankResult.successCount || 0,
        count: tooFastRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 4. 後端重新計算結果與 delta。
     */
    var verified = verifyBattleByServer_(payload);

    if (!ALLOWED_BATTLE_DELTAS[String(verified.delta)]) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: verified.myEnergy,
          enemyEnergy: verified.enemyEnergy,
          mySpeed: verified.mySpeed,
          enemySpeed: verified.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "INVALID_DELTA",
          raw: JSON.stringify(payload)
        }
      );

      return {
        ok: false,
        code: "INVALID_DELTA",
        result: "rejected",
        message: "分數異常，已拒絕結算。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: verified.delta,
        reason: "INVALID_DELTA",

        version: GAS_VERSION
      };
    }

    /*
     * 5. 每日記錄。
     */
    var dateKey = formatDateKey_(now);
    var dailyInfo = findOrCreateDailyLog_(
      dailySheet,
      dateKey,
      userId,
      now
    );

    /*
     * 5-1. 若開啟每日遊玩限制，超過則拒絕結算。
     */
    if (
      ENABLE_DAILY_PLAY_LIMIT_IN_RECORD &&
      Number(dailyInfo.daily.battleCount || 0) >= DAILY_PLAY_LIMIT
    ) {
      appendBattleLog_(
        battleLogsSheet,
        {
          battleId: battleId,
          userId: userId,
          displayName: displayName,
          result: "rejected",
          delta: 0,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: oldScore,
          myEnergy: verified.myEnergy,
          enemyEnergy: verified.enemyEnergy,
          mySpeed: verified.mySpeed,
          enemySpeed: verified.enemySpeed,
          clientTime: payload.clientTime,
          createdAt: now,
          reason: "DAILY_PLAY_LIMIT_REACHED",
          raw: JSON.stringify(payload)
        }
      );

      var dailyLimitRankResult = getFriendRankDataByQuery_({
        userId: userId,
        lineUserId: userId,
        ownerReferralCode: referralCode,
        myReferralCode: referralCode,
        referralCode: referralCode,
        totalScore: oldScore,
        displayName: displayName,
        playerName: displayName,
        pictureUrl: pictureUrl
      });

      var dailyLimitRows = limitRankRows_(
        dailyLimitRankResult.rows || [],
        SECURE_FRIEND_RANK_LIMIT
      );

      return {
        ok: false,
        code: "DAILY_PLAY_LIMIT_REACHED",
        result: "rejected",
        message: "今日遊玩次數已達上限。",

        userId: userId,
        lineUserId: userId,
        battleId: battleId,

        totalScore: oldScore,
        currentScore: oldScore,
        newScore: oldScore,
        score: oldScore,

        delta: 0,
        rawDelta: verified.delta,
        reason: "DAILY_PLAY_LIMIT_REACHED",

        playedToday: Number(dailyInfo.daily.battleCount || 0),
        limit: DAILY_PLAY_LIMIT,

        friendRank: dailyLimitRows,
        rows: dailyLimitRows,
        rank: dailyLimitRows,

        myRank: findMyRankInRows_(dailyLimitRows, userId),
        myPosition: findMyRankInRows_(dailyLimitRows, userId),

        lineInviteFriendCount: dailyLimitRankResult.lineInviteFriendCount || 0,
        referralCount: dailyLimitRankResult.referralCount || 0,
        successCount: dailyLimitRankResult.successCount || 0,
        count: dailyLimitRankResult.count || 0,

        version: GAS_VERSION
      };
    }

    /*
     * 6. 每日正向加分上限。
     */
    var currentPositiveTotal = Number(
      dailyInfo.daily.positiveDeltaTotal || 0
    );

    var finalDelta = verified.delta;
    var reason = "OK";

    if (verified.delta > 0) {
      var remainingPositiveQuota =
        DAILY_POSITIVE_DELTA_LIMIT - currentPositiveTotal;

      if (remainingPositiveQuota <= 0) {
        finalDelta = 0;
        reason = "DAILY_POSITIVE_LIMIT_REACHED";
      } else if (verified.delta > remainingPositiveQuota) {
        finalDelta = remainingPositiveQuota;
        reason = "DAILY_POSITIVE_LIMIT_PARTIAL";
      }
    }

    /*
     * 7. 新總分。
     */
    var newScore = Math.max(
      MIN_TOTAL_SCORE,
      oldScore + finalDelta
    );

    /*
     * 8. 更新 Players。
     */
    updatePlayer_(
      playersSheet,
      playerRowIndex,
      {
        displayName: displayName,
        pictureUrl: pictureUrl,
        referralCode: referralCode,
        totalScore: newScore,
        lastBattleAt: now,
        updatedAt: now
      }
    );

    /*
     * 9. 更新 DailyScoreLogs。
     */
    updateDailyLog_(
      dailySheet,
      dailyInfo.rowIndex,
      {
        positiveDeltaTotal:
          currentPositiveTotal + Math.max(0, finalDelta),
        battleCount: Number(dailyInfo.daily.battleCount || 0) + 1,
        updatedAt: now
      }
    );

    /*
     * 10. 寫 BattleLogs。
     */
    appendBattleLog_(
      battleLogsSheet,
      {
        battleId: battleId,
        userId: userId,
        displayName: displayName,
        result: verified.result,
        delta: finalDelta,
        rawDelta: verified.delta,
        oldScore: oldScore,
        newScore: newScore,
        myEnergy: verified.myEnergy,
        enemyEnergy: verified.enemyEnergy,
        mySpeed: verified.mySpeed,
        enemySpeed: verified.enemySpeed,
        clientTime: payload.clientTime,
        createdAt: now,
        reason: reason,
        raw: JSON.stringify(payload)
      }
    );

    /*
     * 11. 寫原始資料。
     */
    try {
      appendSecureResultToRawLog_(
        payload,
        {
          userId: userId,
          displayName: displayName,
          pictureUrl: pictureUrl,
          referralCode: referralCode,
          battleId: battleId,
          verified: verified,
          delta: finalDelta,
          rawDelta: verified.delta,
          oldScore: oldScore,
          newScore: newScore,
          reason: reason,
          createdAt: now
        }
      );
    } catch (rawLogErr) {}

    /*
     * 12. 回傳好友排行榜。
     */
    var rankResult = getFriendRankDataByQuery_({
      userId: userId,
      lineUserId: userId,
      ownerReferralCode: referralCode,
      myReferralCode: referralCode,
      referralCode: referralCode,
      totalScore: newScore,
      displayName: displayName,
      playerName: displayName,
      pictureUrl: pictureUrl
    });

    var limitedRows = limitRankRows_(
      rankResult.rows || [],
      SECURE_FRIEND_RANK_LIMIT
    );

    var myRank = findMyRankInRows_(limitedRows, userId);

    return {
      ok: true,
      code: "OK",
      result: verified.result,
      message: "結算成功。",

      userId: userId,
      lineUserId: userId,
      battleId: battleId,

      battleResult: verified.result,

      delta: finalDelta,
      rawDelta: verified.delta,

      oldScore: oldScore,
      totalScore: newScore,
      currentScore: newScore,
      newScore: newScore,
      score: newScore,

      points: finalDelta,
      battlePoints: finalDelta,

      reason: reason,

      dailyPositiveDeltaTotal:
        currentPositiveTotal + Math.max(0, finalDelta),
      dailyPositiveDeltaLimit: DAILY_POSITIVE_DELTA_LIMIT,
      playedToday: Number(dailyInfo.daily.battleCount || 0) + 1,

      friendRank: limitedRows,
      rows: limitedRows,
      rank: limitedRows,

      myRank: myRank,
      myPosition: myRank,

      lineInviteFriendCount: rankResult.lineInviteFriendCount || 0,
      referralCount: rankResult.referralCount || 0,
      successCount: rankResult.successCount || 0,
      count: rankResult.count || 0,

      version: GAS_VERSION
    };
  } catch (error) {
    return {
      ok: false,
      code: "SERVER_ERROR",
      result: "error",
      message: String(error && error.message ? error.message : error),
      stack: String(error && error.stack ? error.stack : ""),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseErr) {}
  }
}


/**
 * 後端重新計算戰鬥結果。
 *
 * 目前規則：
 * - 我方能量 > 敵方能量：win，+60
 * - 我方能量 < 敵方能量：lose，-44
 * - 能量相同時比轉速
 * - 我方轉速 > 敵方轉速：win，+60
 * - 我方轉速 < 敵方轉速：lose，-44
 * - 完全相同：draw，+30
 */
function verifyBattleByServer_(payload) {
  payload = payload || {};

  var myEnergy = clampNumber_(
    payload.myEnergy !== undefined
      ? payload.myEnergy
      : payload.playerHp !== undefined
        ? payload.playerHp
        : payload.playerEnergy,
    0,
    100
  );

  var enemyEnergy = clampNumber_(
    payload.enemyEnergy !== undefined
      ? payload.enemyEnergy
      : payload.enemyHp !== undefined
        ? payload.enemyHp
        : payload.enemyEnergy,
    0,
    100
  );

  var mySpeed = clampNumber_(
    payload.mySpeed !== undefined
      ? payload.mySpeed
      : payload.playerSpeed !== undefined
        ? payload.playerSpeed
        : payload.speed,
    0,
    100
  );

  var enemySpeed = clampNumber_(
    payload.enemySpeed !== undefined
      ? payload.enemySpeed
      : payload.rivalSpeed,
    0,
    100
  );

  var result = "draw";
  var delta = 30;

  if (myEnergy > enemyEnergy) {
    result = "win";
    delta = 60;
  } else if (myEnergy < enemyEnergy) {
    result = "lose";
    delta = -44;
  } else if (mySpeed > enemySpeed) {
    result = "win";
    delta = 60;
  } else if (mySpeed < enemySpeed) {
    result = "lose";
    delta = -44;
  } else {
    result = "draw";
    delta = 30;
  }

  return {
    result: result,
    delta: delta,
    myEnergy: myEnergy,
    enemyEnergy: enemyEnergy,
    mySpeed: mySpeed,
    enemySpeed: enemySpeed
  };
}
