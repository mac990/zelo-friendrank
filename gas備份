function handleCheckCoupon(e) {
  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var userId = getSafeParameter_(e, "userId", "");
  var callback = getSafeParameter_(e, "callback", "");
  var found = findRecentCoupon(sheet, userId, DUPLICATE_WINDOW_HOURS);

  var result = found
    ? {
        duplicate: true,
        coupon: found.coupon,
        rank: found.rank,
        claimedAt: found.timeStr,
        version: GAS_VERSION
      }
    : {
        duplicate: false,
        version: GAS_VERSION
      };

  return outputJson_(result, callback);
}

function findRecentCoupon(sheet, userId, hoursWindow) {
  if (!userId || !sheet) return null;

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return null;

  var checkRows = Math.min(lastRow - 1, 1000);
  var startRow = lastRow - checkRows + 1;
  var range = sheet.getRange(startRow, 1, checkRows, Math.min(sheet.getLastColumn(), RAW_HEADERS.length));
  var values = range.getValues();
  var cutoff = new Date().getTime() - hoursWindow * 60 * 60 * 1000;

  for (var i = values.length - 1; i >= 0; i--) {
    var rowTimeVal = values[i][0];
    var rowEventType = values[i][1];
    var rowUserId = values[i][3];
    var rowCoupon = values[i][15];
    var rowRank = values[i][14];
    var rowEpoch = values[i][19];

    if (!rowEpoch && rowTimeVal instanceof Date) {
      rowEpoch = rowTimeVal.getTime();
    }

    if (
      String(rowUserId || "") === String(userId || "") &&
      String(rowEventType || "") === "result" &&
      rowCoupon &&
      rowEpoch &&
      Number(rowEpoch) > cutoff
    ) {
      return {
        coupon: rowCoupon,
        rank: rowRank,
        timeStr: Utilities.formatDate(new Date(Number(rowEpoch)), "Asia/Taipei", "yyyy-MM-dd HH:mm:ss")
      };
    }
  }

  return null;
}


