function normalizeGamePayload_(data) {
  data = data || {};

  var now = new Date();
  var timestampValue = data.timestamp || data.playedAt || data.createdAt || now;
  var timeStr = formatGameTime_(timestampValue);
  var nowEpoch = now.getTime();

  /*
   * 注意：
   * save_result 的 score 只作為原始紀錄 / dashboard 使用。
   * 安全排行榜分數改讀 Players.totalScore。
   */
  var score = toNumberOrBlankGame_(
    data.totalScore !== undefined && data.totalScore !== ""
      ? data.totalScore
      : data.bestScore !== undefined && data.bestScore !== ""
        ? data.bestScore
        : data.score !== undefined && data.score !== ""
          ? data.score
          : data.finalScore !== undefined && data.finalScore !== ""
            ? data.finalScore
            : data.points
  );

  var eventType = normalizeGameEventType_(data.eventType || data.event || data.action, data);

  var playerName =
    data.playerName ||
    data.displayName ||
    data.name ||
    data.nickname ||
    "";

  var userId =
    data.userId ||
    data.userid ||
    data.uid ||
    data.lineUserId ||
    data.ownerLineUserId ||
    "";

  var topName =
    data.topName ||
    data.selectedTopName ||
    data.playerTopName ||
    data.top ||
    "";

  var topType =
    data.topType ||
    data.selectedTopType ||
    data.playerTopType ||
    data.selectedTopId ||
    data.playerTopId ||
    "";

  var topId =
    data.topId ||
    data.selectedTopId ||
    data.playerTopId ||
    "";

  var enemyName =
    data.enemyName ||
    data.enemyTopName ||
    "";

  var enemyType =
    data.enemyType ||
    data.enemyTopType ||
    data.enemyId ||
    data.enemyTopId ||
    "";

  var enemyId =
    data.enemyId ||
    data.enemyTopId ||
    "";

  var coupon =
    data.coupon ||
    data.couponCode ||
    "";

  var power =
    data.power !== undefined && data.power !== ""
      ? data.power
      : data.launchPower !== undefined
        ? data.launchPower
        : "";

  var rank =
    data.rank ||
    data.bestRank ||
    calculateGameRank_(score);

  var inviterId =
    data.inviterId ||
    data.inviterUserId ||
    data.referrerId ||
    data.fromUserId ||
    "";

  /*
   * 若前端傳的是 ZG_xxx，保留到 raw 即可，
   * 不寫入 inviterId 欄位，避免 LINE userId 與 referralCode 混用。
   */
  if (String(inviterId || "").indexOf("ZG_") === 0) {
    inviterId = "";
  }

  return {
    timeStr: timeStr,
    eventType: eventType,
    playerName: playerName,
    userId: userId,

    topName: topName,
    topType: topType,
    topId: topId,

    enemyName: enemyName,
    enemyType: enemyType,
    enemyId: enemyId,

    typeStatus: data.typeStatus || data.typeStatusText || data.result || "",
    typeText: data.typeText || data.typeAdvantageText || "",
    enemyPerfect: data.enemyPerfect !== undefined ? data.enemyPerfect : "",

    power: power,
    launchGrade: data.launchGrade || "",
    score: score,
    rank: rank,
    coupon: coupon,

    pageUrl: data.pageUrl || data.pageurl || data.url || "",
    userAgent: data.userAgent || "",

    duplicateFlag: "",
    nowEpoch: nowEpoch,
    couponStatus: data.couponStatus || "",

    inviterId: inviterId,
    inviterName: data.inviterName || data.referrerName || "",

    result: data.result || "",
    win: data.win !== undefined ? data.win : "",

    pictureUrl: data.pictureUrl || data.avatar || data.avatarUrl || "",

    couponTitle: data.couponTitle || "",

    playerHp:
      data.playerHp !== undefined
        ? data.playerHp
        : data.playerEnergy !== undefined
          ? data.playerEnergy
          : data.myEnergy !== undefined
            ? data.myEnergy
            : "",

    enemyHp:
      data.enemyHp !== undefined
        ? data.enemyHp
        : data.enemyEnergy !== undefined
          ? data.enemyEnergy
          : "",

    version: data.version || GAS_VERSION,
    raw: JSON.stringify(data)
  };
}

function normalizeGameEventType_(eventType, data) {
  var t = String(eventType || "").toLowerCase().trim();

  if (t) {
    if (t === "save_result") return "result";
    if (t === "game_result") return "result";
    if (t === "result") return "result";
    if (t === "recordbattleresult") return "result";
    if (t === "battle_result") return "result";
    if (t === "secure_result") return "result";

    if (t === "copy-coupon") return "coupon_copy";
    if (t === "copycoupon") return "coupon_copy";
    if (t === "couponcopy") return "coupon_copy";
    if (t === "copy_coupon") return "coupon_copy";
    if (t === "download-coupon") return "coupon_copy";

    if (t === "officialsite") return "official_click";
    if (t === "gowebsite") return "official_click";
    if (t === "website") return "official_click";
    if (t === "shop_click") return "official_click";

    if (t === "share_click") return "share";
    if (t === "referral_share_sent") return "share";

    if (t === "playagain") return "play_again";
    if (t === "replay_click") return "play_again";

    if (t === "couponused") return "coupon_redeem";
    if (t === "redeem") return "coupon_redeem";

    return t;
  }

  if (data && data.score !== undefined && data.score !== "") {
    return "result";
  }

  if (data && data.points !== undefined && data.points !== "") {
    return "result";
  }

  return "";
}

function calculateGameRank_(score) {
  var s = Number(score || 0);

  if (s >= 1200) return "S";
  if (s >= 850) return "A";
  return "B";
}


