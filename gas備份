function registerReferral_(body) {
  body = body || {};

  var inviterReferralCode = normalizeReferralCode_(
    body.inviterReferralCode ||
    body.inviterCode ||
    body.ownerReferralCode ||
    body.ref ||
    body.inviterId ||
    ""
  );

  var referredReferralCode = normalizeReferralCode_(
    body.referredReferralCode ||
    body.myReferralCode ||
    body.referralCode ||
    body.inviteeId ||
    ""
  );

  var referredUserId = normalizeString_(
    body.referredUserId ||
    body.userId ||
    body.uid ||
    body.lineUserId ||
    body.inviteeId ||
    ""
  );

  var referredPlayerName = normalizeString_(
    body.referredPlayerName ||
    body.playerName ||
    body.displayName ||
    body.name ||
    body.inviteeName ||
    ""
  );

  var source = normalizeString_(body.source || "");
  var pageUrl = normalizeString_(body.pageUrl || body.url || "");
  var userAgent = normalizeString_(body.userAgent || "");
  var version = normalizeString_(body.version || "");

  if (!inviterReferralCode) {
    return {
      ok: false,
      result: "error",
      message: "Missing inviterReferralCode",
      version: GAS_VERSION
    };
  }

  if (!referredReferralCode && !referredUserId) {
    return {
      ok: false,
      result: "error",
      message: "Missing referred identity",
      version: GAS_VERSION
    };
  }

  if (referredReferralCode && inviterReferralCode === referredReferralCode) {
    return {
      ok: false,
      result: "ignored",
      reason: "self_referral",
      message: "Self referral ignored",
      version: GAS_VERSION
    };
  }

  if (referredUserId && inviterReferralCode === referredUserId) {
    return {
      ok: false,
      result: "ignored",
      reason: "self_referral",
      message: "Self referral ignored",
      version: GAS_VERSION
    };
  }

  var sheet = getReferralSheet_();
  var lastRow = sheet.getLastRow();

  if (lastRow > 1) {
    var values = sheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();

    for (var i = 0; i < values.length; i++) {
      var row = values[i];

      var oldInviter = normalizeString_(row[1]);
      var oldReferredCode = normalizeString_(row[2]);
      var oldReferredUserId = normalizeString_(row[3]);

      if (oldInviter !== inviterReferralCode) continue;

      var duplicatedByUserId =
        referredUserId &&
        oldReferredUserId &&
        referredUserId === oldReferredUserId;

      var duplicatedByReferralCode =
        referredReferralCode &&
        oldReferredCode &&
        referredReferralCode === oldReferredCode;

      if (duplicatedByUserId || duplicatedByReferralCode) {
        var currentCount = countReferralByOwnerCode_(inviterReferralCode);

        return {
          ok: true,
          result: "success",
          duplicated: true,
          message: "Already registered",
          inviterReferralCode: inviterReferralCode,
          referredReferralCode: referredReferralCode,
          referredUserId: referredUserId,
          count: currentCount,
          referralCount: currentCount,
          successCount: currentCount,
          lineInviteFriendCount: currentCount,
          version: GAS_VERSION
        };
      }
    }
  }

  var now = new Date();
  var timeStr = Utilities.formatDate(now, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");

  sheet.appendRow([
    timeStr,
    inviterReferralCode,
    referredReferralCode,
    referredUserId,
    referredPlayerName,
    source,
    pageUrl,
    userAgent,
    version,
    JSON.stringify(body)
  ]);

  var newCount = countReferralByOwnerCode_(inviterReferralCode);

  return {
    ok: true,
    result: "success",
    duplicated: false,
    inviterReferralCode: inviterReferralCode,
    referredReferralCode: referredReferralCode,
    referredUserId: referredUserId,
    count: newCount,
    referralCount: newCount,
    successCount: newCount,
    lineInviteFriendCount: newCount,
    version: GAS_VERSION
  };
}

function getReferralCount_(body) {
  body = body || {};

  var ownerReferralCode = normalizeReferralCode_(
    body.ownerReferralCode ||
    body.referralCode ||
    body.myReferralCode ||
    body.inviterReferralCode ||
    body.inviterCode ||
    body.userId ||
    ""
  );

  if (!ownerReferralCode) {
    return {
      ok: false,
      result: "error",
      count: 0,
      referralCount: 0,
      successCount: 0,
      lineInviteFriendCount: 0,
      message: "Missing ownerReferralCode",
      version: GAS_VERSION
    };
  }

  var count = countReferralByOwnerCode_(ownerReferralCode);

  return {
    ok: true,
    result: "success",
    ownerReferralCode: ownerReferralCode,
    count: count,
    referralCount: count,
    successCount: count,
    lineInviteFriendCount: count,
    version: GAS_VERSION
  };
}

function countReferralByOwnerCode_(ownerReferralCode) {
  ownerReferralCode = normalizeReferralCode_(ownerReferralCode);

  if (!ownerReferralCode) return 0;

  var sheet = getReferralSheet_();
  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) return 0;

  var values = sheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();

  var unique = {};

  for (var i = 0; i < values.length; i++) {
    var row = values[i];

    var inviterReferralCode = normalizeString_(row[1]);
    var referredReferralCode = normalizeString_(row[2]);
    var referredUserId = normalizeString_(row[3]);

    if (inviterReferralCode !== ownerReferralCode) continue;

    var key = referredUserId || referredReferralCode;

    if (key) {
      unique[key] = true;
    }
  }

  return Object.keys(unique).length;
}

function getTotalReferralCount_() {
  var sheet = getReferralSheet_();
  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) return 0;

  var values = sheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();
  var unique = {};

  for (var i = 0; i < values.length; i++) {
    var row = values[i];

    var inviterReferralCode = normalizeString_(row[1]);
    var referredReferralCode = normalizeString_(row[2]);
    var referredUserId = normalizeString_(row[3]);

    var referredKey = referredUserId || referredReferralCode;

    if (inviterReferralCode && referredKey) {
      unique[inviterReferralCode + "::" + referredKey] = true;
    }
  }

  return Object.keys(unique).length;
}

function recordInvite(inviterId, userId, inviterName, playerName) {
  inviterId = normalizeString_(inviterId);
  userId = normalizeString_(userId);
  inviterName = normalizeString_(inviterName);
  playerName = normalizeString_(playerName);

  if (!inviterId || !userId) {
    return {
      ok: false,
      recorded: false,
      reason: "invalid-invite",
      version: GAS_VERSION
    };
  }

  if (inviterId === userId) {
    return {
      ok: false,
      recorded: false,
      reason: "self-referral",
      version: GAS_VERSION
    };
  }

  var result = registerReferral_({
    inviterReferralCode: inviterId,
    referredReferralCode: userId,
    referredUserId: userId,
    referredPlayerName: playerName,
    source: "legacy_recordInvite",
    pageUrl: "",
    userAgent: "",
    version: GAS_VERSION
  });

  return {
    ok: result.ok,
    recorded: result.ok && !result.duplicated,
    duplicated: !!result.duplicated,
    inviterId: inviterId,
    inviteeId: userId,
    count: result.count || 0,
    result: result.result || "",
    version: GAS_VERSION
  };
}


