// ============================================================

function recordGachaDraw_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      action: "gacha_draw",
      message: "系統忙碌中，扭蛋紀錄稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var sheet = getGachaDrawSheet_();
    ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

    var now = new Date();

    var draw = payload.draw || {};
    var user = payload.user || {};
    var reward = payload.reward || {};
    var pool = payload.pool || {};
    var points = payload.points || {};

    var drawId = sanitizeText_(
      draw.drawId ||
      payload.drawId ||
      "",
      160
    );

    if (!drawId) {
      drawId =
        "server_draw_" +
        now.getTime().toString(36) +
        "_" +
        Math.random().toString(36).slice(2, 8);
    }

    /*
     * 簡單去重：
     * 同一 drawId 若最近 5000 筆出現過，就不重複寫入。
     */
    if (gachaDrawIdAlreadyUsed_(sheet, drawId)) {
      return {
        ok: true,
        code: "DUPLICATE_GACHA_DRAW",
        result: "ignored",
        action: "gacha_draw",
        duplicated: true,
        drawId: drawId,
        message: "此扭蛋紀錄已存在，已略過重複寫入。",
        version: GAS_VERSION
      };
    }

    var createdAt =
      draw.createdAt ||
      payload.createdAt ||
      now.toISOString();

    var createdAtLocal =
      draw.createdAtLocal ||
      payload.createdAtLocal ||
      Utilities.formatDate(now, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");

    var source =
      sanitizeText_(payload.source || draw.source || "frontend", 80);

    var drawSource =
      sanitizeText_(draw.drawSource || payload.drawSource || "", 80);

    var userId = sanitizeText_(
      user.userId ||
      draw.userId ||
      payload.userId ||
      "",
      160
    );

    var lineUserId = sanitizeText_(
      user.lineUserId ||
      draw.lineUserId ||
      payload.lineUserId ||
      userId ||
      "",
      160
    );

    var playerName = sanitizeText_(
      user.playerName ||
      draw.playerName ||
      payload.playerName ||
      payload.displayName ||
      "",
      100
    );

    var referralCode = normalizeReferralCode_(
      user.referralCode ||
      draw.referralCode ||
      payload.referralCode ||
      ""
    );

    var poolId = sanitizeText_(
      pool.poolId ||
      draw.poolId ||
      payload.poolId ||
      "",
      100
    );

    var poolTitle = sanitizeText_(
      pool.poolTitle ||
      draw.poolTitle ||
      payload.poolTitle ||
      "",
      100
    );

    var poolBadge = sanitizeText_(
      draw.poolBadge ||
      pool.poolBadge ||
      "",
      80
    );

    var poolTheme = sanitizeText_(
      draw.poolTheme ||
      pool.poolTheme ||
      "",
      80
    );

    var cost = Number(
      pool.cost !== undefined
        ? pool.cost
        : draw.cost !== undefined
          ? draw.cost
          : payload.cost || 0
    );

    var rewardId = sanitizeText_(
      reward.rewardId ||
      draw.rewardId ||
      payload.rewardId ||
      "",
      120
    );

    var rewardName = sanitizeText_(
      reward.rewardName ||
      draw.rewardName ||
      payload.rewardName ||
      "",
      200
    );

    var rewardType = sanitizeText_(
      reward.rewardType ||
      draw.rewardType ||
      payload.rewardType ||
      "",
      80
    );

    var rewardPoints = Number(
      draw.rewardPoints !== undefined
        ? draw.rewardPoints
        : reward.rewardPoints !== undefined
          ? reward.rewardPoints
          : payload.rewardPoints || 0
    );

    var rarity = sanitizeText_(
      reward.rarity ||
      draw.rarity ||
      payload.rarity ||
      "",
      80
    );

    var delivery = sanitizeText_(
      reward.delivery ||
      draw.delivery ||
      payload.delivery ||
      "",
      120
    );

    var isNoPrize =
      reward.isNoPrize === true ||
      draw.isNoPrize === true ||
      payload.isNoPrize === true ||
      rewardType === "none";

    var beforePoints = Number(
      points.beforePoints !== undefined
        ? points.beforePoints
        : draw.beforePoints !== undefined
          ? draw.beforePoints
          : payload.beforePoints || 0
    );

    var afterCostPoints = Number(
      points.afterCostPoints !== undefined
        ? points.afterCostPoints
        : draw.afterCostPoints !== undefined
          ? draw.afterCostPoints
          : payload.afterCostPoints || 0
    );

    var afterPoints = Number(
      points.afterPoints !== undefined
        ? points.afterPoints
        : draw.afterPoints !== undefined
          ? draw.afterPoints
          : payload.afterPoints || 0
    );

    var rewardPointsDelta = Number(
      points.rewardPointsDelta !== undefined
        ? points.rewardPointsDelta
        : draw.rewardPointsDelta !== undefined
          ? draw.rewardPointsDelta
          : payload.rewardPointsDelta || 0
    );

    var notifyLine =
      draw.notifyLine === true ||
      payload.notifyLine === true;

    var clientVersion = sanitizeText_(
      payload.version ||
      draw.version ||
      draw.clientVersion ||
      "",
      120
    );

    /*
     * Claim / 派發狀態
     *
     * none：
     *   未中獎，不需要派發。
     *
     * auto_granted：
     *   點數獎勵，前端已自動加點。
     *
     * pending：
     *   折扣券、實體獎品、LINE 通知獎品等待後續處理。
     */
    var claimStatus = sanitizeText_(
      draw.claimStatus ||
      payload.claimStatus ||
      "",
      60
    );

    if (!claimStatus) {
      if (rewardType === "none" || isNoPrize === true) {
        claimStatus = "none";
      } else if (rewardType === "points") {
        claimStatus = "auto_granted";
      } else {
        claimStatus = "pending";
      }
    }

    var claimedAt = sanitizeText_(
      draw.claimedAt ||
      payload.claimedAt ||
      "",
      80
    );

    var claimedBy = sanitizeText_(
      draw.claimedBy ||
      payload.claimedBy ||
      "",
      100
    );

    var claimNote = sanitizeText_(
      draw.claimNote ||
      payload.claimNote ||
      "",
      300
    );

    var couponCode = sanitizeText_(
      draw.couponCode ||
      payload.couponCode ||
      "",
      120
    );

    var lineNotifiedAt = sanitizeText_(
      draw.lineNotifiedAt ||
      payload.lineNotifiedAt ||
      "",
      80
    );

    sheet.appendRow([

      createdAt,
      createdAtLocal,
      drawId,
      source,
      drawSource,

      userId,
      lineUserId,
      playerName,
      referralCode,

      poolId,
      poolTitle,
      poolBadge,
      poolTheme,
      cost,

      rewardId,
      rewardName,
      rewardType,
      rewardPoints,
      rarity,
      delivery,
      isNoPrize,

      beforePoints,
      afterCostPoints,
      afterPoints,
      rewardPointsDelta,

      notifyLine,
      "logged",
      clientVersion,
      GAS_VERSION,
      JSON.stringify(payload),

      claimStatus,
      claimedAt,
      claimedBy,
      claimNote,
      couponCode,
      lineNotifiedAt
    ]);


    return {
      ok: true,
      code: "OK",
      result: "success",
      action: "gacha_draw",
      drawId: drawId,
      sheet: GACHA_DRAW_SHEET_NAME,
      isNoPrize: isNoPrize,
      rewardType: rewardType,
      rewardName: rewardName,
      notifyLine: notifyLine,
      claimStatus: claimStatus,
      version: GAS_VERSION
    };
  } catch (error) {
    return {
      ok: false,
      code: "SERVER_ERROR",
      result: "error",
      action: "gacha_draw",
      message: String(error && error.message ? error.message : error),
      stack: String(error && error.stack ? error.stack : ""),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseErr) {}
  }
}


function recordGachaClaim_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      action: "gacha_claim",
      message: "系統忙碌中，派發狀態稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var sheet = getGachaDrawSheet_();
    ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

    var drawId = sanitizeText_(
      payload.drawId ||
      (payload.draw && payload.draw.drawId) ||
      "",
      120
    );

    if (!drawId) {
      return {
        ok: false,
        code: "MISSING_DRAW_ID",
        result: "error",
        action: "gacha_claim",
        message: "缺少 drawId，無法更新派發狀態。",
        version: GAS_VERSION
      };
    }

    var claimStatus = sanitizeText_(
      payload.claimStatus ||
      (payload.draw && payload.draw.claimStatus) ||
      "claimed",
      60
    );

    var claimedAt = sanitizeText_(
      payload.claimedAt ||
      (payload.draw && payload.draw.claimedAt) ||
      Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss"),
      80
    );

    var claimedBy = sanitizeText_(
      payload.claimedBy ||
      (payload.draw && payload.draw.claimedBy) ||
      "admin",
      100
    );

    var claimNote = sanitizeText_(
      payload.claimNote ||
      (payload.draw && payload.draw.claimNote) ||
      "",
      300
    );

    var couponCode = sanitizeText_(
      payload.couponCode ||
      (payload.draw && payload.draw.couponCode) ||
      "",
      120
    );

    var lineNotifiedAt = sanitizeText_(
      payload.lineNotifiedAt ||
      (payload.draw && payload.draw.lineNotifiedAt) ||
      "",
      80
    );

    var lastRow = sheet.getLastRow();
    var lastCol = sheet.getLastColumn();

    if (lastRow < 2) {
      return {
        ok: false,
        code: "EMPTY_SHEET",
        result: "error",
        action: "gacha_claim",
        drawId: drawId,
        message: "GachaDraws 沒有資料列。",
        version: GAS_VERSION
      };
    }

    var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    var colMap = {};

    headers.forEach(function (header, index) {
      if (header) {
        colMap[String(header)] = index + 1;
      }
    });

    var drawIdCol = colMap.drawId;
    var claimStatusCol = colMap.claimStatus;
    var claimedAtCol = colMap.claimedAt;
    var claimedByCol = colMap.claimedBy;
    var claimNoteCol = colMap.claimNote;
    var couponCodeCol = colMap.couponCode;
    var lineNotifiedAtCol = colMap.lineNotifiedAt;

    if (!drawIdCol) {
      return {
        ok: false,
        code: "MISSING_DRAW_ID_COLUMN",
        result: "error",
        action: "gacha_claim",
        message: "GachaDraws 缺少 drawId 欄位。",
        version: GAS_VERSION
      };
    }

    if (!claimStatusCol) {
      return {
        ok: false,
        code: "MISSING_CLAIM_COLUMNS",
        result: "error",
        action: "gacha_claim",
        message: "GachaDraws 缺少 claimStatus 欄位，請確認表頭已更新。",
        version: GAS_VERSION
      };
    }

    var drawIdValues = sheet.getRange(2, drawIdCol, lastRow - 1, 1).getValues();

    var targetRow = 0;

    for (var i = 0; i < drawIdValues.length; i++) {
      if (String(drawIdValues[i][0]) === String(drawId)) {
        targetRow = i + 2;
        break;
      }
    }

    if (!targetRow) {
      return {
        ok: false,
        code: "DRAW_NOT_FOUND",
        result: "error",
        action: "gacha_claim",
        drawId: drawId,
        message: "找不到指定 drawId 的扭蛋紀錄。",
        version: GAS_VERSION
      };
    }

    sheet.getRange(targetRow, claimStatusCol).setValue(claimStatus);

    if (claimedAtCol) {
      sheet.getRange(targetRow, claimedAtCol).setValue(claimedAt);
    }

    if (claimedByCol) {
      sheet.getRange(targetRow, claimedByCol).setValue(claimedBy);
    }

    if (claimNoteCol) {
      sheet.getRange(targetRow, claimNoteCol).setValue(claimNote);
    }

    if (couponCodeCol) {
      sheet.getRange(targetRow, couponCodeCol).setValue(couponCode);
    }

    if (lineNotifiedAtCol) {
      sheet.getRange(targetRow, lineNotifiedAtCol).setValue(lineNotifiedAt);
    }

    return {
      ok: true,
      code: "OK",
      result: "success",
      action: "gacha_claim",
      drawId: drawId,
      row: targetRow,
      claimStatus: claimStatus,
      claimedAt: claimedAt,
      claimedBy: claimedBy,
      couponCode: couponCode,
      lineNotifiedAt: lineNotifiedAt,
      version: GAS_VERSION
    };
  } catch (err) {
    return {
      ok: false,
      code: "GACHA_CLAIM_ERROR",
      result: "error",
      action: "gacha_claim",
      message: err && err.message ? err.message : String(err),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseError) {}
  }
}


function gachaDrawIdAlreadyUsed_(sheet, drawId) {
  if (!sheet || !drawId) return false;

  ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) return false;

  /*
   * GACHA_DRAW_HEADERS 第 3 欄是 drawId。
   * 只掃最近 5000 筆，避免分頁太大時變慢。
   */
  var checkRows = Math.min(lastRow - 1, 5000);
  var startRow = lastRow - checkRows + 1;

  var values = sheet
    .getRange(startRow, 3, checkRows, 1)
    .getValues();

  var targetDrawId = String(drawId || "");

  for (var i = values.length - 1; i >= 0; i--) {
    var oldDrawId = String(values[i][0] || "");

    if (oldDrawId === targetDrawId) {
      return true;
    }
  }

  return false;
}


// ============================================================
// 八之二、【本次新增完整實作】隱藏陀螺兌換碼 / Secret Redeem Code
// ============================================================

/*
 * redeemSecretCode_(payload)
 *
 * 前端呼叫範例：
 * {
 *   action: "secret_redeem",
 *   userId: "line-user-id",
 *   displayName: "玩家名稱",
 *   secretId: "secret-shadow",   // 對應前端按鈕 data-secret-id
 *   redeemCode: "SHADOW2026"     // 玩家輸入的兌換碼
 * }
 *
 * 回傳格式：
 * {
 *   ok: true/false,
 *   code: "OK" | "WRONG_CODE" | "MAX_USES_REACHED" | "INACTIVE" |
 *         "SECRET_NOT_FOUND" | "MISSING_SECRET_ID" | "MISSING_CODE" |
 *         "INVALID_USER_ID" | "LOCK_TIMEOUT" | "SERVER_ERROR",
 *   message: "顯示給玩家的訊息",
 *   alreadyUnlocked: true/false,
 *   secretId, toyId, toyName,
 *   version
 * }
 *
 * 設計重點：
 * 1. 使用 LockService 防止同時間大量請求造成 usedCount 計算錯誤。
 * 2. 同一玩家對同一 secretId 只會計入一次 usedCount
 *    （避免玩家重複送出同一組正確代碼，導致名額被自己用光）。
 * 3. 所有嘗試（成功/失敗）都會寫入 SecretRedeemLogs，方便事後稽核。
 * 4. maxUses = -1 表示無限制次數。
 */
function redeemSecretCode_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      message: "系統忙碌中，請稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var userId = normalizeUserIdFromPayload_(payload);

    var displayName = sanitizeText_(
      payload.displayName ||
      payload.playerName ||
      payload.name ||
      "玩家",
      60
    );

    var secretId = normalizeSecretId_(
      payload.secretId ||
      payload.secretID ||
      payload.buttonId ||
      ""
    );

    var inputCode = normalizeRedeemCode_(
      payload.redeemCode ||
      payload.code ||
      payload.inputCode ||
      ""
    );

    if (!userId || !isValidUserId(userId)) {
  logSecretRedeemAttempt_({
    userId: userId || "",
    displayName: displayName,
    secretId: secretId,
    toyId: "",
    toyName: "",
    inputCode: inputCode,
    result: "error",
    reason: "INVALID_USER_ID",
    raw: JSON.stringify(payload)
  });

  return {
    ok: false,
    code: "INVALID_USER_ID",
    result: "error",
    message: "缺少有效使用者身分，請重新登入後再試。",
    version: GAS_VERSION
  };
}

    if (!secretId) {
      return {
        ok: false,
        code: "MISSING_SECRET_ID",
        result: "error",
        message: "缺少 secretId 參數。",
        version: GAS_VERSION
      };
    }

    if (!inputCode) {
      logSecretRedeemAttempt_({
        userId: userId,
        displayName: displayName,
        secretId: secretId,
        toyId: "",
        toyName: "",
        inputCode: "",
        result: "error",
        reason: "MISSING_CODE",
        raw: JSON.stringify(payload)
      });

      return {
        ok: false,
        code: "MISSING_CODE",
        result: "error",
        message: "請輸入兌換碼。",
        version: GAS_VERSION
      };
    }

    var codeSheet = getSecretCodeSheet_();
    ensureGenericHeader_(codeSheet, SECRET_CODE_HEADERS);

    var values = codeSheet.getDataRange().getValues();
    var header = values[0] || SECRET_CODE_HEADERS;
    var index = headerIndexMap_(header);

    var targetRowIndex = -1;
    var targetRow = null;

    for (var i = 1; i < values.length; i++) {
      var row = values[i];
      var rowSecretId = normalizeSecretId_(row[index.secretId]);

      if (rowSecretId === secretId) {
        targetRowIndex = i + 1;
        targetRow = row;
        break;
      }
    }

    if (targetRowIndex === -1) {
      logSecretRedeemAttempt_({
        userId: userId,
        displayName: displayName,
        secretId: secretId,
        toyId: "",
        toyName: "",
        inputCode: inputCode,
        result: "error",
        reason: "SECRET_NOT_FOUND",
        raw: JSON.stringify(payload)
      });

      return {
        ok: false,
        code: "SECRET_NOT_FOUND",
        result: "error",
        message: "查無此隱藏陀螺設定，請確認 secretId 是否正確。",
        secretId: secretId,
        version: GAS_VERSION
      };
    }

    var storedCode = normalizeRedeemCode_(targetRow[index.redeemCode]);
    var toyId = sanitizeText_(targetRow[index.toyId], 100);
    var toyName = sanitizeText_(targetRow[index.toyName], 100);
    var maxUsesRaw = targetRow[index.maxUses];
    var maxUses = maxUsesRaw === "" || maxUsesRaw === null || maxUsesRaw === undefined
      ? -1
      : Number(maxUsesRaw);
    var usedCount = Number(targetRow[index.usedCount] || 0);
    var active = toBoolValue_(targetRow[index.active]);

    if (!active) {
      logSecretRedeemAttempt_({
        userId: userId,
        displayName: displayName,
        secretId: secretId,
        toyId: toyId,
        toyName: toyName,
        inputCode: inputCode,
        result: "error",
        reason: "INACTIVE",
        raw: JSON.stringify(payload)
      });

      return {
        ok: false,
        code: "INACTIVE",
        result: "error",
        message: "此兌換活動目前未開放。",
        secretId: secretId,
        version: GAS_VERSION
      };
    }

    if (!storedCode || storedCode !== inputCode) {
      logSecretRedeemAttempt_({
        userId: userId,
        displayName: displayName,
        secretId: secretId,
        toyId: toyId,
        toyName: toyName,
        inputCode: inputCode,
        result: "error",
        reason: "WRONG_CODE",
        raw: JSON.stringify(payload)
      });

      return {
        ok: false,
        code: "WRONG_CODE",
        result: "error",
        message: "兌換碼錯誤，請再確認一次。",
        secretId: secretId,
        version: GAS_VERSION
      };
    }

    /*
     * 檢查此玩家是否已經解鎖過這個 secretId。
     * 若已解鎖過，直接回傳成功（讓前端可以正常顯示已解鎖狀態），
     * 但不會重複增加 usedCount，避免名額被同一人重複佔用。
     */
    var unlockSheet = getPlayerSecretUnlockSheet_();
    ensureGenericHeader_(unlockSheet, PLAYER_SECRET_UNLOCK_HEADERS);

    var alreadyUnlocked = checkPlayerSecretAlreadyUnlocked_(
      unlockSheet,
      userId,
      secretId
    );

    if (!alreadyUnlocked) {
      /*
       * 只有「非重複兌換」才檢查名額並占用名額。
       */
      if (maxUses !== -1 && usedCount >= maxUses) {
        logSecretRedeemAttempt_({
          userId: userId,
          displayName: displayName,
          secretId: secretId,
          toyId: toyId,
          toyName: toyName,
          inputCode: inputCode,
          result: "error",
          reason: "MAX_USES_REACHED",
          raw: JSON.stringify(payload)
        });

        return {
          ok: false,
          code: "MAX_USES_REACHED",
          result: "error",
          message: "此兌換碼名額已滿。",
          secretId: secretId,
          version: GAS_VERSION
        };
      }

      var now = new Date();

      codeSheet.getRange(targetRowIndex, index.usedCount + 1).setValue(usedCount + 1);
      codeSheet.getRange(targetRowIndex, index.updatedAt + 1).setValue(now);

      unlockSheet.appendRow([
        userId,
        secretId,
        toyId,
        toyName,
        now
      ]);
    }

    logSecretRedeemAttempt_({
      userId: userId,
      displayName: displayName,
      secretId: secretId,
      toyId: toyId,
      toyName: toyName,
      inputCode: inputCode,
      result: "success",
      reason: "OK",
      raw: JSON.stringify(payload)
    });

    return {
      ok: true,
      code: "OK",
      result: "success",
      message: alreadyUnlocked
        ? "此陀螺您先前已解鎖過囉！"
        : "兌換成功，隱藏陀螺已解鎖！",
      alreadyUnlocked: alreadyUnlocked,
      secretId: secretId,
      toyId: toyId,
      toyName: toyName,
      version: GAS_VERSION
    };
  } catch (error) {
    return {
      ok: false,
      code: "SERVER_ERROR",
      result: "error",
      message: String(error && error.message ? error.message : error),
      stack: String(error && error.stack ? error.stack : ""),
      version: GAS_VERSION
    };
  } finally {
    try {
      lock.releaseLock();
    } catch (releaseErr) {}
  }
}

/*
 * 檢查某玩家是否已經解鎖過某個 secretId。
 * 只掃最近 5000 筆，避免資料量大時效能變差。
 */
function checkPlayerSecretAlreadyUnlocked_(unlockSheet, userId, secretId) {
  ensureGenericHeader_(unlockSheet, PLAYER_SECRET_UNLOCK_HEADERS);

  var lastRow = unlockSheet.getLastRow();

  if (lastRow <= 1) return false;

  var checkRows = Math.min(lastRow - 1, 5000);
  var startRow = lastRow - checkRows + 1;

  var values = unlockSheet
    .getRange(startRow, 1, checkRows, 2)
    .getValues();

  var targetUserId = String(userId || "");
  var targetSecretId = String(secretId || "");

  for (var i = values.length - 1; i >= 0; i--) {
    var rowUserId = String(values[i][0] || "");
    var rowSecretId = String(values[i][1] || "");

    if (rowUserId === targetUserId && rowSecretId === targetSecretId) {
      return true;
    }
  }

  return false;
}

/*
 * 【新增】判斷某個 toyId 是否為「隱藏陀螺」。
 */
function isSecretToyId_(toyId) {
  toyId = normalizeString_(toyId);

  if (!toyId) return false;

  var sheet = getSecretCodeSheet_();
  ensureGenericHeader_(sheet, SECRET_CODE_HEADERS);

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return false;

  var values = sheet.getDataRange().getValues();
  var index = headerIndexMap_(values[0]);

  for (var i = 1; i < values.length; i++) {
    if (normalizeString_(values[i][index.toyId]) === toyId) {
      return true;
    }
  }

  return false;
}

/*
 * 【新增】判斷某玩家是否已解鎖指定 toyId。
 */
function playerOwnsToyId_(userId, toyId) {
  userId = normalizeString_(userId);
  toyId = normalizeString_(toyId);

  if (!userId || !toyId) return false;

  var sheet = getPlayerSecretUnlockSheet_();
  ensureGenericHeader_(sheet, PLAYER_SECRET_UNLOCK_HEADERS);

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return false;

  var checkRows = Math.min(lastRow - 1, 5000);
  var startRow = lastRow - checkRows + 1;

  var values = sheet
    .getRange(startRow, 1, checkRows, 3)
    .getValues();

  for (var i = values.length - 1; i >= 0; i--) {
    var rowUserId = normalizeString_(values[i][0]);
    var rowToyId = normalizeString_(values[i][2]);

    if (rowUserId === userId && rowToyId === toyId) {
      return true;
    }
  }

  return false;
}



/*
 * 寫入一筆兌換嘗試紀錄（無論成功或失敗）到 SecretRedeemLogs。
 */
function logSecretRedeemAttempt_(log) {
  log = log || {};

  try {
    var sheet = getSecretRedeemLogSheet_();
    ensureGenericHeader_(sheet, SECRET_REDEEM_LOG_HEADERS);

    sheet.appendRow([
      generateUniqueId_("redeem"),
      log.userId || "",
      log.displayName || "",
      log.secretId || "",
      log.toyId || "",
      log.toyName || "",
      log.inputCode || "",
      log.result || "",
      log.reason || "",
      new Date(),
      log.raw || ""
    ]);
  } catch (errLog) {
    /*
     * 記錄失敗不應該影響主流程結果，只靜默忽略。
     */
  }
}

/*
 * 【本次新增】給前端同步已解鎖清單使用。
 * 可在遊戲載入時呼叫，取得該玩家目前所有已解鎖的隱藏陀螺，
 * 避免玩家換裝置或清快取後，前端 localStorage 遺失解鎖狀態。
 *
 * 建議在 doGet 中新增一個 action，例如：
 *
 *   if (action === "getPlayerSecretUnlocks") {
 *     return outputJson_(
 *       getPlayerSecretUnlocks_(getSafeParameter_(e, "userId", "")),
 *       callback
 *     );
 *   }
 */
function getPlayerSecretUnlocks_(userId) {
  userId = normalizeString_(userId);

  if (!userId) {
    return {
      ok: false,
      userId: "",
      unlocks: [],
      message: "Missing userId",
      version: GAS_VERSION
    };
  }

  var sheet = getPlayerSecretUnlockSheet_();
  ensureGenericHeader_(sheet, PLAYER_SECRET_UNLOCK_HEADERS);

  var lastRow = sheet.getLastRow();
  var unlocks = [];

  if (lastRow > 1) {
    var values = sheet.getDataRange().getValues();
    var header = values[0];
    var index = headerIndexMap_(header);

    for (var i = 1; i < values.length; i++) {
      var row = values[i];

      if (String(row[index.userId] || "") === userId) {
        unlocks.push({
          secretId: String(row[index.secretId] || ""),
          toyId: String(row[index.toyId] || ""),
          toyName: String(row[index.toyName] || ""),
          unlockedAt: row[index.unlockedAt] instanceof Date
            ? Utilities.formatDate(row[index.unlockedAt], "Asia/Taipei", "yyyy-MM-dd HH:mm:ss")
            : String(row[index.unlockedAt] || "")
        });
      }
    }
  }

  return {
    ok: true,
    userId: userId,
    unlocks: unlocks,
    totalUnlocked: unlocks.length,
    version: GAS_VERSION
  };
}

