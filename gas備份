function exportReport(type) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var sheetId = sheet.getSheetId();
  var dateStr = Utilities.formatDate(new Date(), "Asia/Taipei", "yyyyMMdd");

  var format = type === "xlsx" ? "xlsx" : "pdf";
  var url = "https://docs.google.com/spreadsheets/d/" + ss.getId() + "/export"
    + "?format=" + format
    + "&gid=" + sheetId
    + "&portrait=false&size=A4&fitw=true";

  var token = ScriptApp.getOAuthToken();

  var response = UrlFetchApp.fetch(url, {
    headers: {
      Authorization: "Bearer " + token
    }
  });

  var blob = response.getBlob();

  var ext = format === "xlsx" ? ".xlsx" : ".pdf";
  var mime = format === "xlsx"
    ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    : "application/pdf";

  blob.setName("ZELO_Report_" + dateStr + ext);

  return {
    filename: blob.getName(),
    mimeType: mime,
    base64: Utilities.base64Encode(blob.getBytes())
  };
}


