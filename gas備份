function getSafeParameter_(e, key, defaultValue) {
  if (!e || !e.parameter) return defaultValue || "";
  return e.parameter[key] || defaultValue || "";
}

function outputJson_(result, callback) {
  var json = JSON.stringify(result || {});

  if (callback) {
    return ContentService
      .createTextOutput(callback + "(" + json + ");")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }

  return ContentService
    .createTextOutput(json)
    .setMimeType(ContentService.MimeType.JSON);
}

function jsonOutput_(data) {
  var json = JSON.stringify(data || {});

  return ContentService
    .createTextOutput(json)
    .setMimeType(ContentService.MimeType.JSON);
}

function normalizeString_(value) {
  return String(value || "").trim();
}

function normalizeReferralCode_(value) {
  return String(value || "")
    .trim()
    .replace(/[^\w-]/g, "")
    .slice(0, 80);
}

function sanitizeText_(value, maxLength) {
  return String(value || "")
    .replace(/[\u0000-\u001F\u007F]/g, "")
    .trim()
    .slice(0, maxLength || 200);
}

function normalizeUserIdFromPayload_(payload) {
  payload = payload || {};

  return sanitizeText_(
    payload.userId ||
    payload.lineUserId ||
    payload.ownerLineUserId ||
    payload.uid ||
    "",
    120
  );
}

function normalizeBattleIdFromPayload_(payload) {
  payload = payload || {};

  return sanitizeText_(
    payload.battleId ||
    payload.roundId ||
    payload.clientBattleId ||
    "",
    160
  );
}

/*
 * 【本次新增】給隱藏陀螺兌換碼系統使用的通用小工具。
 * 用於正規化使用者輸入的兌換碼：
 * - 去除前後空白
 * - 轉大寫（避免大小寫造成兌換失敗）
 * - 限制長度避免異常輸入
 */
function normalizeRedeemCode_(value) {
  return String(value || "")
    .trim()
    .toUpperCase()
    .slice(0, 60);
}

/*
 * 【本次新增】正規化 secretId，例如前端傳入 "secret-shadow"。
 * 允許英數、底線、連字號。
 */
function normalizeSecretId_(value) {
  return String(value || "")
    .trim()
    .replace(/[^\w-]/g, "")
    .slice(0, 80);
}

function toScoreNumber_(value) {
  if (typeof value === "number") return value;
  if (value === "" || value === null || value === undefined) return 0;

  var n = Number(value);
  return isNaN(n) ? 0 : n;
}

function toNumberOrBlankGame_(value) {
  if (value === "" || value === null || value === undefined) {
    return "";
  }

  var n = Number(value);
  return isNaN(n) ? "" : n;
}

function clampNumber_(value, min, max) {
  var number = Number(value);

  if (!isFinite(number)) return min;

  return Math.max(
    min,
    Math.min(
      max,
      Math.round(number)
    )
  );
}

function formatTaipeiDateTime_(value) {
  try {
    if (value instanceof Date) {
      return Utilities.formatDate(value, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
    }

    var d = new Date(value);

    if (!isNaN(d.getTime())) {
      return Utilities.formatDate(d, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
    }
  } catch (err) {}

  return "";
}

function formatGameTime_(value) {
  try {
    if (Object.prototype.toString.call(value) === "[object Date]") {
      return Utilities.formatDate(value, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
    }

    var d = new Date(value);

    if (!isNaN(d.getTime())) {
      return Utilities.formatDate(d, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
    }

    return Utilities.formatDate(new Date(), "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
  } catch (err) {
    return Utilities.formatDate(new Date(), "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
  }
}

function formatDateKey_(date) {
  return Utilities.formatDate(
    date || new Date(),
    "Asia/Taipei",
    "yyyy-MM-dd"
  );
}

function getRowDateStringTaipei_(rowTimeVal, epoch) {
  try {
    if (epoch) {
      return Utilities.formatDate(new Date(Number(epoch)), "Asia/Taipei", "yyyy-MM-dd");
    }

    if (rowTimeVal instanceof Date) {
      return Utilities.formatDate(rowTimeVal, "Asia/Taipei", "yyyy-MM-dd");
