// ============================================================

/*
 * Shopify Webhook 用途：
 * 當玩家在遊戲中拿到折扣券並在 Shopify 完成訂單後，
 * Shopify 會呼叫這個 Webhook（orders/create），
 * 我們比對訂單使用的折扣碼是否為遊戲發出的 coupon，
 * 若是，則回填 RawData 對應列的「訂單狀態」欄位，
 * 方便後續計算「遊戲帶動的實際轉換率 / 營收」。
 */





/**
 * 處理 Shopify 訂單建立 Webhook。
 *
 * 比對邏輯：
 * 1. 取出 order.discount_codes 內所有折扣碼。
 * 2. 到 RawData 找出使用相同 coupon 的最近一筆遊戲紀錄
 *    （限制在 DUPLICATE_WINDOW_HOURS * 3 小時內，避免誤配對過舊紀錄）。
 * 3. 若找到，回填該列的「couponStatus」欄位為 "converted"，
 *    並記錄 Shopify 訂單編號、訂單金額、下單時間。
 */
function handleShopifyOrderWebhook_(order) {
  try {
    var discountCodes = (order.discount_codes || [])
      .map(function(dc) {
        return normalizeString_(dc.code).toUpperCase();
      })
      .filter(function(code) {
        return !!code;
      });

    if (discountCodes.length === 0) {
      return outputJson_(
        {
          ok: true,
          code: "NO_DISCOUNT_CODE",
          message: "此訂單未使用折扣碼，略過比對。",
          orderId: order.id,
          version: GAS_VERSION
        },
        ""
      );
    }

    var sheet = getRawSheet_();
    ensureRawHeader_(sheet);

    var lastRow = sheet.getLastRow();

    if (lastRow <= 1) {
      return outputJson_(
        {
          ok: true,
          code: "EMPTY_RAW_SHEET",
          message: "RawData 尚無資料可比對。",
          version: GAS_VERSION
        },
        ""
      );
    }

    var readColumns = Math.min(Math.max(sheet.getLastColumn(), 21), RAW_HEADERS.length);
    var checkRows = Math.min(lastRow - 1, 5000);
    var startRow = lastRow - checkRows + 1;

    var values = sheet
      .getRange(startRow, 1, checkRows, readColumns)
      .getValues();

    var matchedRows = [];
    var orderCreatedAt = order.created_at
      ? new Date(order.created_at)
      : new Date();

    var windowMs = DUPLICATE_WINDOW_HOURS * 3 * 60 * 60 * 1000;

    for (var i = values.length - 1; i >= 0; i--) {
      var row = values[i];
      var rowCoupon = normalizeString_(row[15]).toUpperCase();

      if (!rowCoupon || discountCodes.indexOf(rowCoupon) === -1) {
        continue;
      }

      var rowEpoch = Number(row[19] || 0);
      var rowTime = rowEpoch
        ? new Date(rowEpoch)
        : parseRawDateCell_(row[0]);

      if (!rowTime) continue;

      var diffMs = Math.abs(orderCreatedAt.getTime() - rowTime.getTime());

      if (diffMs <= windowMs) {
        matchedRows.push({
          rowIndex: startRow + i,
          coupon: rowCoupon,
          userId: normalizeString_(row[3]),
          playerName: normalizeString_(row[2])
        });
      }
    }

    if (matchedRows.length === 0) {
      return outputJson_(
        {
          ok: true,
          code: "NO_MATCH_FOUND",
          message: "找不到對應的遊戲折扣碼紀錄。",
          discountCodes: discountCodes,
          orderId: order.id,
          version: GAS_VERSION
        },
        ""
      );
    }

    /*
     * 只回填最新的一筆比對結果，避免同碼多次使用時全部覆蓋。
     */
    var match = matchedRows[0];

    sheet.getRange(match.rowIndex, 21).setValue("converted");

    logShopifyConversion_({
      orderId: order.id,
      orderNumber: order.order_number,
      totalPrice: order.total_price,
      currency: order.currency,
      couponCode: match.coupon,
      userId: match.userId,
      playerName: match.playerName,
      matchedRow: match.rowIndex,
      createdAt: order.created_at
    });

    return outputJson_(
      {
        ok: true,
        code: "OK",
        message: "已成功比對並回填訂單轉換狀態。",
        orderId: order.id,
        matchedRow: match.rowIndex,
        matchedUserId: match.userId,
        matchedCoupon: match.coupon,
        version: GAS_VERSION
      },
      ""
    );
  } catch (error) {
    return outputJson_(
      {
        ok: false,
        code: "SHOPIFY_WEBHOOK_ERROR",
        message: String(error && error.message ? error.message : error),
        version: GAS_VERSION
      },
      ""
    );
  }
}


/**
 * 嘗試從 RawData 的時間字串欄位解析出 Date。
 * 若失敗回傳 null。
 */
function parseRawDateCell_(cell) {
  if (cell instanceof Date) return cell;

  if (typeof cell === "string" && cell) {
    var parsed = new Date(cell.replace(" ", "T"));

    if (!isNaN(parsed.getTime())) {
      return parsed;
    }
  }

  return null;
}


/**
 * 記錄一筆 Shopify 轉換成功事件到獨立分頁，
 * 方便日後計算 ROI / 遊戲帶動營收報表。
 */
function logShopifyConversion_(info) {
  info = info || {};

  try {
    var sheet = getShopifyConversionSheet_();
    ensureGenericHeader_(sheet, SHOPIFY_CONVERSION_HEADERS);

    sheet.appendRow([
      info.orderId || "",
      info.orderNumber || "",
      info.totalPrice || "",
      info.currency || "",
      info.couponCode || "",
      info.userId || "",
      info.playerName || "",
      info.matchedRow || "",
      info.createdAt || "",
      new Date()
    ]);
  } catch (errLog) {
    /*
     * 記錄失敗不應影響主流程，靜默忽略。
     */
  }
}


function getShopifyConversionSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHOPIFY_CONVERSION_SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(SHOPIFY_CONVERSION_SHEET_NAME);
    sheet.appendRow(SHOPIFY_CONVERSION_HEADERS);
  }

  return sheet;
}

