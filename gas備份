function lookupPlayerNameByUserId(userId) {
  userId = normalizeString_(userId);

  if (!userId) return "";

  /*
   * 優先從 Players 讀名稱。
   */
  try {
    var playerSheet = getPlayerSheet_();
    var lastRowPlayer = playerSheet.getLastRow();

    if (lastRowPlayer > 1) {
      var playerValues = playerSheet.getDataRange().getValues();
      var playerHeader = playerValues[0];
      var playerIndex = headerIndexMap_(playerHeader);

      for (var p = playerValues.length - 1; p >= 1; p--) {
        var prow = playerValues[p];
        var puid = normalizeString_(prow[playerIndex.userId]);
        var pname = normalizeString_(prow[playerIndex.displayName]);

        if (puid === userId && pname) {
          return pname;
        }
      }
    }
  } catch (errPlayerName) {}

  /*
   * 找不到再從原始資料找。
   */
  var sheet = getRawSheet_();

  if (!sheet) return "";

  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) return "";

  var checkRows = Math.min(lastRow - 1, 3000);
  var startRow = lastRow - checkRows + 1;
  var values = sheet.getRange(startRow, 1, checkRows, 4).getValues();

  for (var i = values.length - 1; i >= 0; i--) {
    var row = values[i];
    var uid = normalizeString_(row[3]);
    var playerName = normalizeString_(row[2]);

    if (uid === userId && playerName) {
      return playerName;
    }
  }

  return "";
}

