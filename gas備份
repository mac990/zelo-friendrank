function getFriendRankPreviewData(userId) {
  userId = normalizeString_(userId);

  var refSheet = getReferralSheet_();
  var inviteCounts = {};
  var lastRow = refSheet.getLastRow();

  if (lastRow > 1) {
    var refData = refSheet.getRange(2, 1, lastRow - 1, REFERRAL_HEADERS.length).getValues();
    var unique = {};

    for (var i = 0; i < refData.length; i++) {
      var inviterId = normalizeString_(refData[i][1]);
      var inviteeId = normalizeString_(refData[i][3] || refData[i][2]);

      if (!inviterId || !inviteeId) continue;

      var uniqueKey = inviterId + "::" + inviteeId;
      if (unique[uniqueKey]) continue;
      unique[uniqueKey] = true;

      if (!inviteCounts[inviterId]) {
        inviteCounts[inviterId] = {
          name: lookupPlayerNameByUserId(inviterId) || inviterId,
          count: 0
        };
      }

      inviteCounts[inviterId].count++;
    }
  }

  var list = [];

  for (var uid in inviteCounts) {
    if (inviteCounts.hasOwnProperty(uid)) {
      list.push({
        userId: uid,
        name: inviteCounts[uid].name,
        count: inviteCounts[uid].count
      });
    }
  }

  list.sort(function(a, b) {
    if (b.count !== a.count) {
      return b.count - a.count;
    }

    if (a.userId === userId && b.userId !== userId) return -1;
    if (a.userId !== userId && b.userId === userId) return 1;

    return String(a.name || "").localeCompare(String(b.name || ""));
  });

  for (var j = 0; j < list.length; j++) {
    list[j].position = j + 1;
  }

  var top = list.slice(0, 3).map(function(item) {
    return {
      userId: item.userId,
      name: item.name,
      count: item.count,
      position: item.position,
      isMe: item.userId === userId
    };
  });

  var myRank = 0;
  var myCount = 0;

  for (var k = 0; k < list.length; k++) {
    if (list[k].userId === userId) {
      myRank = list[k].position;
      myCount = list[k].count;
      break;
    }
  }

  return {
    ok: true,
    top: top,
    myRank: myRank,
    myCount: myCount,
    totalRankedUsers: list.length,
    version: GAS_VERSION
  };
}


