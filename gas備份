/*
 * 【一次性修復工具】重建 GachaDraws 分頁。
 *
 * 背景：
 * 因為 GACHA_DRAW_HEADERS 欄位定義在開發過程中曾多次擴充，
 * 而 ensureGenericHeader_() 只會把新欄位「加到最後面」，
 * 導致實際表格上的欄位順序，跟程式碼陣列 (appendRow) 期待的順序不一致，
 * 造成寫入資料時「值」跑到錯誤的欄位，讓 clientNonce 等關鍵欄位讀不到正確資料。
 *
 * 這個函式會直接刪除整張 GachaDraws 分頁並重新建立，
 * 讓欄位順序完全對齊目前最新版的 GACHA_DRAW_HEADERS。
 *
 * ⚠️ 注意：這會清空 GachaDraws 裡所有現有資料（含測試資料）。
 * 只建議在測試階段執行；若已有正式玩家抽獎紀錄，
 * 請先自行備份（複製工作表）再執行。
 */
function resetGachaDrawSheetForTesting() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var oldSheet = ss.getSheetByName(GACHA_DRAW_SHEET_NAME);

  if (oldSheet) {
    ss.deleteSheet(oldSheet);
  }

  var newSheet = getGachaDrawSheet_();

  return "✅ GachaDraws 已重建完成，欄位順序已修正為最新版本，共 " +
    newSheet.getLastColumn() + " 欄。";
}



