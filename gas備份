function recordGachaDraw_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      action: "gacha_draw",
      message: "系統忙碌中，扭蛋紀錄稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var sheet = getGachaDrawSheet_();
    ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

    var now = new Date();

    var draw = payload.draw || {};
    var user = payload.user || {};
    var reward = payload.reward || {};
    var pool = payload.pool || {};
    var points = payload.points || {};

    var drawId = sanitizeText_(
      draw.drawId ||
      payload.drawId ||
      "",
      160
    );

    if (!drawId) {
      drawId =
        "server_draw_" +
        now.getTime().toString(36) +
        "_" +
        Math.random().toString(36).slice(2, 8);
    }

    /*
     * 簡單去重：
     * 同一 drawId 若最近 5000 筆出現過，就不重複寫入。
     */
    if (gachaDrawIdAlreadyUsed_(sheet, drawId)) {
      return {
        ok: true,
        code: "DUPLICATE_GACHA_DRAW",
        result: "ignored",
        action: "gacha_draw",
        duplicated: true,
        drawId: drawId,
        message: "此扭蛋紀錄已存在，已略過重複寫入。",
        version: GAS_VERSION
      };
    }

    var createdAt =
      draw.createdAt ||
      payload.createdAt ||
      now.toISOString();

    var createdAtLocal =
      draw.createdAtLocal ||
      payload.createdAtLocal ||
      Utilities.formatDate(now, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");

    var source =
      sanitizeText_(payload.source || draw.source || "frontend", 80);

    var drawSource =
      sanitizeText_(draw.drawSource || payload.drawSource || "", 80);

    var userId = sanitizeText_(
      user.userId ||
      draw.userId ||
      payload.userId ||
      "",
      160
    );

    var lineUserId = sanitizeText_(
      user.lineUserId ||
      draw.lineUserId ||
      payload.lineUserId ||
      userId ||
      "",
      160
    );

    var playerName = sanitizeText_(
      user.playerName ||
      draw.playerName ||
      payload.playerName ||
      payload.displayName ||
      "",
      100
    );

    var referralCode = normalizeReferralCode_(
      user.referralCode ||
      draw.referralCode ||
      payload.referralCode ||
      ""
    );

    var poolId = sanitizeText_(
      pool.poolId ||
      draw.poolId ||
      payload.poolId ||
      "",
      100
    );

    var poolTitle = sanitizeText_(
      pool.poolTitle ||
      draw.poolTitle ||
      payload.poolTitle ||
      "",
      100
    );

    var poolBadge = sanitizeText_(
      draw.poolBadge ||
      pool.poolBadge ||
      "",
      80
    );

