    var now = new Date();

    for (var d = 13; d >= 0; d--) {
      var dayDate = new Date(now.getTime() - d * 24 * 60 * 60 * 1000);
      var key = Utilities.formatDate(dayDate, "Asia/Taipei", "MM/dd");
      dayMap[key] = { users: {}, games: 0 };
    }

    for (var i = 0; i < values.length; i++) {
      var row = values[i];
      var rowTimeVal = row[0];
      var eventType = normalizeGameEventType_(row[1], {});
      var userId = row[3];
      var topName = row[4];
      var score = row[13];
      var rank = row[14];
      var coupon = row[15];
      var duplicateFlag = row[18];
      var epoch = row[19];
      var usedFlag = row[20];

      if (!epoch && rowTimeVal instanceof Date) {
        epoch = rowTimeVal.getTime();
      }

      if (userId) {
        uniqueUsers[userId] = true;
      }

      var dayKey = null;

      if (epoch) {
        dayKey = Utilities.formatDate(new Date(Number(epoch)), "Asia/Taipei", "MM/dd");
      } else if (rowTimeVal instanceof Date) {
        dayKey = Utilities.formatDate(rowTimeVal, "Asia/Taipei", "MM/dd");
      } else if (rowTimeVal) {
        var parsedDate = new Date(rowTimeVal);

        if (!isNaN(parsedDate.getTime())) {
          dayKey = Utilities.formatDate(parsedDate, "Asia/Taipei", "MM/dd");
        }
      }

      if (eventType === "result") {
        dashboardData.totalGames++;
        dashboardData.funnel.games++;

        if (rank === "S" || rank === "A" || rank === "B") {
          dashboardData.rankCount[rank]++;
        }

        if (typeof score === "number") {
          scoreSum += score;
          scoreCount++;
        } else if (score !== "" && score !== null && score !== undefined && !isNaN(Number(score))) {
          scoreSum += Number(score);
          scoreCount++;
        }

        if (topName) {
          dashboardData.topCount[topName] = (dashboardData.topCount[topName] || 0) + 1;
        }

        if (duplicateFlag) {
          dashboardData.duplicateBlocked++;
        }

        if (coupon) {
          dashboardData.couponIssued++;

          if (usedFlag === "已使用") {
            dashboardData.couponUsed++;
          }
        }

        if (dayKey && dayMap[dayKey]) {
          dayMap[dayKey].games++;

          if (userId) {
            dayMap[dayKey].users[userId] = true;
          }
        }
      }

      if (eventType === "share") dashboardData.funnel.share++;
      if (eventType === "coupon_copy") dashboardData.funnel.copy++;
      if (eventType === "official_click") dashboardData.funnel.shop++;
    }

    dashboardData.totalUsers = Object.keys(uniqueUsers).length;
    dashboardData.avgScore = scoreCount > 0 ? Math.round((scoreSum / scoreCount) * 10) / 10 : 0;

    var dayKeys = Object.keys(dayMap);

    for (var k = 0; k < dayKeys.length; k++) {
      var key2 = dayKeys[k];

      dashboardData.dailyTrend.push({
        date: key2,
        users: Object.keys(dayMap[key2].users).length,
        games: dayMap[key2].games
      });
    }

    var startIdx = Math.max(0, values.length - 20);

    for (var r = values.length - 1; r >= startIdx; r--) {
      var rr = values[r];
      var t = rr[0];
      var timeText = t instanceof Date ? Utilities.formatDate(t, "Asia/Taipei", "MM/dd HH:mm") : String(t || "");

      dashboardData.recentRows.push({
        time: timeText,
        event: rr[1] || "",
        player: rr[2] || "",
        top: rr[4] || "",
        score: rr[13] || "",
        rank: rr[14] || "",
        coupon: rr[15] || "",
        dup: rr[18] || "",
        used: rr[20] || ""
      });
    }
  }

  return dashboardData;
}

function getSecureDashboardStats_() {
  var stats = {
    totalPlayers: 0,
    totalScore: 0,
    avgTotalScore: 0,
    totalBattles: 0,
    rejectedBattles: 0,
    duplicateBattles: 0,
    tooFastBattles: 0,
    dailyLimitRejected: 0,
    positiveLimitReached: 0
  };

  try {
    var playerSheet = getPlayerSheet_();
    var pLastRow = playerSheet.getLastRow();

    if (pLastRow > 1) {
      var pValues = playerSheet.getDataRange().getValues();
      var pIndex = headerIndexMap_(pValues[0]);

      for (var p = 1; p < pValues.length; p++) {
        var uid = normalizeString_(pValues[p][pIndex.userId]);
        if (!uid) continue;

        if (
          uid === "me-local" ||
          uid === "guest" ||
          uid === "anonymous"
        ) {
          continue;
        }

        var totalScore = Number(pValues[p][pIndex.totalScore] || 0);

        stats.totalPlayers++;
        stats.totalScore += totalScore;
      }

      stats.avgTotalScore = stats.totalPlayers > 0
        ? Math.round((stats.totalScore / stats.totalPlayers) * 10) / 10
        : 0;
    }
  } catch (errPlayers) {}

  try {
    var battleSheet = getBattleLogSheet_();
    var bLastRow = battleSheet.getLastRow();

    if (bLastRow > 1) {
      var bValues = battleSheet.getDataRange().getValues();
      var bIndex = headerIndexMap_(bValues[0]);

      for (var b = 1; b < bValues.length; b++) {
        var reason = normalizeString_(bValues[b][bIndex.reason]);
        var result = normalizeString_(bValues[b][bIndex.result]);
        var userId = normalizeString_(bValues[b][bIndex.userId]);

        if (
          userId === "me-local" ||
          userId === "guest" ||
          userId === "anonymous"
        ) {
          continue;
        }

        stats.totalBattles++;

        if (
          result === "rejected" ||
          reason === "DUPLICATE_BATTLE" ||
          reason === "TOO_FAST" ||
          reason === "DAILY_PLAY_LIMIT_REACHED" ||
          reason === "INVALID_DELTA"
        ) {
          stats.rejectedBattles++;
        }

        if (reason === "DUPLICATE_BATTLE") {
          stats.duplicateBattles++;
        }

        if (reason === "TOO_FAST") {
          stats.tooFastBattles++;
        }

        if (reason === "DAILY_PLAY_LIMIT_REACHED") {
          stats.dailyLimitRejected++;
        }

        if (
          reason === "DAILY_POSITIVE_LIMIT_REACHED" ||
          reason === "DAILY_POSITIVE_LIMIT_PARTIAL"
        ) {
          stats.positiveLimitReached++;
        }
      }
    }
  } catch (errBattles) {}

  return stats;
}

