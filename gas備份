    }
  }

  var lastRow = sheet.getLastRow();

  if (lastRow > 1) {
    var readColumns = Math.min(Math.max(sheet.getLastColumn(), 33), RAW_HEADERS.length);
    var values = sheet.getRange(2, 1, lastRow - 1, readColumns).getValues();

    for (var r = 0; r < values.length; r++) {
      var row = values[r];
      var eventType = normalizeGameEventType_(row[1], {});
      var playerName = normalizeString_(row[2]);
      var uid2 = normalizeString_(row[3]);
      var score = toScoreNumber_(row[13]);
      var rank = normalizeString_(row[14]);
      var pictureUrl = normalizeString_(row[25]);

      if (eventType !== "result" || !idSet[uid2]) continue;

      if (!result[uid2] || score > result[uid2].bestScore) {
        result[uid2] = {
          playerName: playerName || uid2,
          bestScore: score,
          bestRank: rank || "",
          pictureUrl: pictureUrl || ""
        };
      } else if (result[uid2] && !result[uid2].pictureUrl && pictureUrl) {
        result[uid2].pictureUrl = pictureUrl;
      }
    }
  }

  for (var uid3 in idSet) {
    if (idSet.hasOwnProperty(uid3) && !result[uid3]) {
      result[uid3] = {
        playerName: lookupPlayerNameByUserId(uid3) || uid3,
        bestScore: 0,
        bestRank: "",
        pictureUrl: ""
      };
    }
  }

  return result;
}

