function doPost(e) {
  var rawBody = e && e.postData && e.postData.contents ? e.postData.contents : "";
  var data;

  try {
    data = JSON.parse(rawBody || "{}");
  } catch (err) {
    data = {};
  }

  /*
   * 【本次修正】優先判斷是否為 Shopify 訂單建立 Webhook。
   * Shopify 訂單物件必定帶有 id 與 discount_codes 欄位，
   * 前端遊戲送出的 payload 不會有這兩個欄位同時存在，
   * 因此用這個特徵即可安全區分兩種來源，不需要額外標頭判斷。
   */
  var looksLikeShopifyOrder =
    data &&
    data.id !== undefined &&
    data.discount_codes !== undefined;

  if (looksLikeShopifyOrder) {
    return handleShopifyOrderWebhook_(data);
  }

  var action = String(data.action || "").trim();

  /*
   * Referral 註冊。
   */
  if (
    action === "register_referral" ||
    action === "register_liff_referral"
  ) {
    return jsonOutput_(registerReferral_(data));
  }

  /*
   * Referral count。
   */
  if (
    action === "get_referral_count" ||
    action === "get_liff_referral_count" ||
    action === "referralCount"
  ) {
    return jsonOutput_(getReferralCount_(data));
  }


  /*
   * 扭蛋抽獎紀錄。
   * 正式紀錄只允許 POST。
   */
  if (
    action === "gacha_draw" ||
    action === "recordGachaDraw" ||
    action === "gacha_draw_log"
  ) {
    return jsonOutput_(recordGachaDraw_(data));
  }

  /*
   * 安全扭蛋抽獎（後端權威版本）。
   * 後端重新抽獎、重新扣點加點，不採信前端傳來的獎品/點數。
   * 正式抽獎只允許 POST。
   */
  if (
    action === "gacha_draw_secure" ||
    action === "drawGachaSecure" ||
    action === "secure_gacha_draw"
  ) {
    return jsonOutput_(drawGachaSecure_(data));
  }

  /*
   * 查詢玩家目前的 ZELO Points 權威數值。
   * 給前端開機同步用，保留 POST 支援。
   */
  if (
    action === "get_zelo_points" ||
    action === "getZeloPoints"
  ) {
    return jsonOutput_(
      getZeloPointsSecure_(data.userId || data.lineUserId || "")
    );
  }


  /*
   * 扭蛋獎品派發 / 核銷狀態更新。
   * 正式更新只允許 POST。
   */
  if (
    action === "gacha_claim" ||
    action === "recordGachaClaim" ||
    action === "gacha_claim_update"
  ) {
    return jsonOutput_(recordGachaClaim_(data));
  }

  /*
   * 隱藏陀螺兌換碼。
   * 只允許 POST，避免兌換碼被寫在網址列外洩。
   */
  if (
    action === "secret_redeem" ||
    action === "redeemSecretCode" ||
    action === "secret-redeem-submit"
  ) {
    return jsonOutput_(redeemSecretCode_(data));
  }

  /*
   * 【本次新增】查詢玩家已解鎖的隱藏陀螺清單。
   * 雖然多半用 GET 查詢即可，但保留 POST 支援方便前端統一呼叫方式。
   */
  if (
  action === "get_player_secret_unlocks" ||
  action === "getPlayerSecretUnlocks"
) {
  return jsonOutput_(
    getPlayerSecretUnlocks_(data.userId || data.lineUserId || "")
  );
}


  /*
   * 安全戰鬥結算。
   *
   * 正式積分結算只允許 POST。
   * 不要再用 save_result 當排行榜分數來源。
   */
  if (
    action === "recordBattleResult" ||
    action === "battle_result" ||
    action === "record_battle_result" ||
    action === "secure_result"
  ) {
    return jsonOutput_(recordBattleResult(data));
  }

  /*
   * 舊版允許寫入原始資料的 action。
   * save_result 保留給 Dashboard / funnel / coupon / log 使用。
   */
  var allowedWriteActions = {
    "": true,
    "save_result": true,
    "result": true,
    "game_result": true,

    "share": true,
    "share_click": true,
    "referral_share_sent": true,

    "copy-coupon": true,
    "copycoupon": true,
    "couponcopy": true,
    "copy_coupon": true,
    "download-coupon": true,

    "officialsite": true,
    "gowebsite": true,
    "website": true,
    "shop_click": true,

    "playagain": true,
    "replay_click": true,

    "couponused": true,
    "redeem": true
  };

  if (!allowedWriteActions[action]) {
    return jsonOutput_({
      ok: false,
      result: "ignored",
      action: action,
      message: "Unknown action ignored",
      version: GAS_VERSION
    });
  }

  if (
    action === "save_result" ||
    action === "result" ||
    action === "game_result"
  ) {
    data.eventType = data.eventType || "result";
  }

  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var normalized = normalizeGamePayload_(data);

  /*
   * 不把 ZG_xxx referral code 當 LINE inviterId 記 legacy invite。
   * ZG_xxx 邀請關係由 registerReferral_ 處理。
   */
  if (
    normalized.inviterId &&
