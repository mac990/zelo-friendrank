function doPost(e) {
  var data;

  try {
    data = JSON.parse(e && e.postData && e.postData.contents ? e.postData.contents : "{}");
  } catch (err) {
    data = {};
  }

  var action = String(data.action || "").trim();

  /*
   * Referral 註冊。
   */
  if (
    action === "register_referral" ||
    action === "register_liff_referral"
  ) {
    return jsonOutput_(registerReferral_(data));
  }

  /*
   * Referral count。
   */
  if (
    action === "get_referral_count" ||
    action === "get_liff_referral_count" ||
    action === "referralCount"
  ) {
    return jsonOutput_(getReferralCount_(data));
  }

  /*
   * 扭蛋抽獎紀錄。
   * 正式紀錄只允許 POST。
   */
  if (
    action === "gacha_draw" ||
    action === "recordGachaDraw" ||
    action === "gacha_draw_log"
  ) {
    return jsonOutput_(recordGachaDraw_(data));
  }

    /*
   * 扭蛋獎品派發 / 核銷狀態更新。
   * 正式更新只允許 POST。
   */
  if (
    action === "gacha_claim" ||
    action === "recordGachaClaim" ||
    action === "gacha_claim_update"
  ) {
    return jsonOutput_(recordGachaClaim_(data));
  }


  /*
   * 安全戰鬥結算。
   *
   * 正式積分結算只允許 POST。
   * 不要再用 save_result 當排行榜分數來源。
   */
  if (
    action === "recordBattleResult" ||
    action === "battle_result" ||
    action === "secure_result"
  ) {
    return jsonOutput_(recordBattleResult(data));
  }

  /*
   * 舊版允許寫入原始資料的 action。
   * save_result 保留給 Dashboard / funnel / coupon / log 使用。
   */
  var allowedWriteActions = {
    "": true,
    "save_result": true,
    "result": true,
    "game_result": true,

    "share": true,
    "share_click": true,
    "referral_share_sent": true,

    "copy-coupon": true,
    "copycoupon": true,
    "couponcopy": true,
    "copy_coupon": true,
    "download-coupon": true,

    "officialsite": true,
    "gowebsite": true,
    "website": true,
    "shop_click": true,

    "playagain": true,
    "replay_click": true,

    "couponused": true,
    "redeem": true
  };

  if (!allowedWriteActions[action]) {
    return jsonOutput_({
      ok: false,
      result: "ignored",
      action: action,
      message: "Unknown action ignored",
      version: GAS_VERSION
    });
  }

  if (
    action === "save_result" ||
    action === "result" ||
    action === "game_result"
  ) {
    data.eventType = data.eventType || "result";
  }

  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var normalized = normalizeGamePayload_(data);

  /*
   * 不把 ZG_xxx referral code 當 LINE inviterId 記 legacy invite。
   * ZG_xxx 邀請關係由 registerReferral_ 處理。
   */
  if (
    normalized.inviterId &&
    normalized.userId &&
    normalized.inviterId !== normalized.userId &&
    String(normalized.inviterId).indexOf("ZG_") !== 0
  ) {
    try {
      recordInvite(
        normalized.inviterId,
        normalized.userId,
        normalized.inviterName,
        normalized.playerName
      );
    } catch (errInvite) {}
  }

  var duplicateFlag = "";

  if (
    normalized.eventType === "result" &&
    normalized.coupon &&
    normalized.userId
  ) {
    var found = findRecentCoupon(sheet, normalized.userId, DUPLICATE_WINDOW_HOURS);

    if (found) {
      duplicateFlag = "重複領取(" + DUPLICATE_WINDOW_HOURS + "hr內)";
    }
  }

  normalized.duplicateFlag = duplicateFlag;

  sheet.appendRow([
    normalized.timeStr,
    normalized.eventType,
    normalized.playerName,
    normalized.userId,
    normalized.topName,
    normalized.topType,
    normalized.enemyName,
    normalized.enemyType,
    normalized.typeStatus,
    normalized.typeText,
    normalized.enemyPerfect,
    normalized.power,
    normalized.launchGrade,
    normalized.score,
    normalized.rank,
    normalized.coupon,
    normalized.pageUrl,
    normalized.userAgent,
    normalized.duplicateFlag,
    normalized.nowEpoch,
    normalized.couponStatus,
    normalized.inviterId,
    normalized.inviterName,
    normalized.result,
    normalized.win,
    normalized.pictureUrl,
    normalized.couponTitle,
    normalized.topId,
    normalized.enemyId,
    normalized.playerHp,
    normalized.enemyHp,
    normalized.version,
    normalized.raw
  ]);

  return jsonOutput_({
    result: "success",
    ok: true,
    action: action || normalized.eventType || "result",
    duplicate: duplicateFlag !== "",
    duplicateFlag: duplicateFlag,
    version: GAS_VERSION
  });
}



