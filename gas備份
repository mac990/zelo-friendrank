function statRow(label, value) {
  return "<tr style='border-bottom:1px solid #eee;'>"
    + "<td style='color:#555;'>" + label + "</td>"
    + "<td style='text-align:right;font-weight:bold;color:#10172f;'>" + value + "</td>"
    + "</tr>";
}

function buildTopRankingHtml(topCount) {
  var entries = [];

  for (var key in topCount) {
    if (topCount.hasOwnProperty(key)) {
      entries.push({
        name: key,
        count: topCount[key]
      });
    }
  }

  entries.sort(function(a, b) {
    return b.count - a.count;
  });

  if (entries.length === 0) {
    return "<p style='color:#999;font-size:13px;'>本期間尚無遊玩紀錄</p>";
  }

  var html = "<table style='width:100%;border-collapse:collapse;font-size:14px;' cellpadding='8'>";

  for (var i = 0; i < entries.length; i++) {
    html += "<tr style='border-bottom:1px solid #eee;'>"
      + "<td>" + (i + 1) + ". " + entries[i].name + "</td>"
      + "<td style='text-align:right;font-weight:bold;'>" + entries[i].count + " 次</td>"
      + "</tr>";
  }

  html += "</table>";

  return html;
}


