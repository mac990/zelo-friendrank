function getDailyLimitData(userId) {
  userId = normalizeString_(userId);

  if (!userId) {
    return {
      ok: false,
      userId: "",
      playedToday: 0,
      playsUsed: 0,
      limit: DAILY_PLAY_LIMIT,
      dailyPlayLimitEnabled: ENABLE_DAILY_PLAY_LIMIT_IN_RECORD,
      canPlay: true,
      blocked: false,
      remaining: ENABLE_DAILY_PLAY_LIMIT_IN_RECORD ? DAILY_PLAY_LIMIT : 999999,
      reason: "missing-userId",
      resetTimezone: "Asia/Taipei",
      dailyPositiveDeltaLimit: DAILY_POSITIVE_DELTA_LIMIT,
      version: GAS_VERSION
    };
  }

  /*
   * 優先讀 DailyScoreLogs。
   *
   * 注意：
   * playedToday 目前代表「成功結算筆數」。
   * rejected / duplicate / too_fast 不會增加 battleCount。
   */
  var todayStr = Utilities.formatDate(new Date(), "Asia/Taipei", "yyyy-MM-dd");
  var playedToday = 0;

  try {
    var dailySheet = getDailyScoreLogSheet_();
    var lastDailyRow = dailySheet.getLastRow();

    if (lastDailyRow > 1) {
      var dailyValues = dailySheet.getDataRange().getValues();
      var dailyHeader = dailyValues[0];
      var dailyIndex = headerIndexMap_(dailyHeader);

      for (var d = 1; d < dailyValues.length; d++) {
        var drow = dailyValues[d];

        if (
          normalizeString_(drow[dailyIndex.dateKey]) === todayStr &&
          normalizeString_(drow[dailyIndex.userId]) === userId
        ) {
          playedToday = Number(drow[dailyIndex.battleCount] || 0);
          break;
        }
      }
    }
  } catch (errDaily) {
    /*
     * 若 DailyScoreLogs 有問題，fallback 掃原始資料。
     */
    var sheet = getRawSheet_();
    ensureRawHeader_(sheet);

    var lastRow = sheet.getLastRow();

    if (lastRow > 1) {
      var checkRows = Math.min(lastRow - 1, 3000);
      var startRow = lastRow - checkRows + 1;
      var readColumns = Math.min(Math.max(sheet.getLastColumn(), 20), RAW_HEADERS.length);
      var values = sheet.getRange(startRow, 1, checkRows, readColumns).getValues();

      for (var i = 0; i < values.length; i++) {
        var row = values[i];
        var eventType = normalizeGameEventType_(row[1], {});
        var uid = normalizeString_(row[3]);
        var rowTimeVal = row[0];
        var epoch = row[19];

        if (eventType !== "result" || uid !== userId) {
          continue;
        }

        var rowDateStr = getRowDateStringTaipei_(rowTimeVal, epoch);

        if (rowDateStr === todayStr) {
          playedToday++;
        }
      }
    }
  }

  /*
   * 關鍵修正：
   * 若 ENABLE_DAILY_PLAY_LIMIT_IN_RECORD = false，
   * 表示玩家可以一直再戰，只限制每日正向加分上限。
   *
   * 因此前端 checkDailyLimit 不應回傳 blocked。
   */
  var canPlay = ENABLE_DAILY_PLAY_LIMIT_IN_RECORD
    ? playedToday < DAILY_PLAY_LIMIT
    : true;

  var remaining = ENABLE_DAILY_PLAY_LIMIT_IN_RECORD
    ? Math.max(0, DAILY_PLAY_LIMIT - playedToday)
    : 999999;

  return {
    ok: true,
    userId: userId,

    playedToday: playedToday,
    playsUsed: playedToday,

    limit: DAILY_PLAY_LIMIT,
    dailyPlayLimitEnabled: ENABLE_DAILY_PLAY_LIMIT_IN_RECORD,

    canPlay: canPlay,
    blocked: !canPlay,
    remaining: remaining,

    resetTimezone: "Asia/Taipei",
    resetAt: todayStr + " 24:00:00",

    dailyPositiveDeltaLimit: DAILY_POSITIVE_DELTA_LIMIT,

    /*
     * 給前端顯示用：
     * 若 dailyPlayLimitEnabled=false，請顯示「可繼續遊玩」，
     * 不要顯示今日剩餘場次為 999999。
     */
    message: ENABLE_DAILY_PLAY_LIMIT_IN_RECORD
      ? "每日遊玩限制啟用中。"
      : "每日遊玩限制未啟用，目前僅限制每日正向加分上限。",

    version: GAS_VERSION
  };
}
