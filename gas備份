function handleDashboardStats(e) {
  var callback = getSafeParameter_(e, "callback", "");
  var days = Number(getSafeParameter_(e, "days", "7")) || 7;

  var result = getDashboardStatsData_(days);

  return outputJson_(result, callback);
}

/**
 * 儀表板統計資料。
 *
 * 統計範圍：
 * - 近 N 天 BattleLogs 的勝/敗/平/拒絕次數
 * - 近 N 天新增玩家數（Players.updatedAt 首次出現）
 * - 近 N 天扭蛋抽獎次數與各獎項分布
 * - 目前總玩家數 / 總對戰數
 */
function getDashboardStatsData_(days) {
  days = days || 7;

  var now = new Date();
  var cutoff = new Date(now.getTime() - days * 24 * 60 * 60 * 1000);

  var stats = {
    ok: true,
    rangeDays: days,
    generatedAt: Utilities.formatDate(now, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss"),

    totalPlayers: 0,
    newPlayersInRange: 0,

    totalBattles: 0,
    battlesInRange: 0,
    winCount: 0,
    loseCount: 0,
    drawCount: 0,
    rejectedCount: 0,
    rejectReasons: {},

    totalGachaDraws: 0,
    gachaDrawsInRange: 0,
    gachaRewardBreakdown: {},

    totalSecretRedeems: 0,
    secretRedeemsInRange: 0,
    secretRedeemSuccessInRange: 0,

    version: GAS_VERSION
  };

  /*
   * Players 統計。
   */
  try {
    var playersSheet = getPlayerSheet_();
    var lastPlayerRow = playersSheet.getLastRow();

    if (lastPlayerRow > 1) {
      var playerValues = playersSheet.getDataRange().getValues();
      var playerHeader = playerValues[0];
      var playerIndex = headerIndexMap_(playerHeader);

      stats.totalPlayers = playerValues.length - 1;

      for (var p = 1; p < playerValues.length; p++) {
        var prow = playerValues[p];
        var updatedAt = prow[playerIndex.updatedAt];

        if (updatedAt instanceof Date && updatedAt.getTime() >= cutoff.getTime()) {
          stats.newPlayersInRange++;
        }
      }
    }
  } catch (errPlayers) {}

  /*
   * BattleLogs 統計。
   */
  try {
    var battleSheet = getBattleLogSheet_();
    var lastBattleRow = battleSheet.getLastRow();

    if (lastBattleRow > 1) {
      var battleValues = battleSheet.getDataRange().getValues();
      var battleHeader = battleValues[0];
      var battleIndex = headerIndexMap_(battleHeader);

      stats.totalBattles = battleValues.length - 1;

      for (var b = 1; b < battleValues.length; b++) {
        var brow = battleValues[b];
        var createdAt = brow[battleIndex.createdAt];
        var result = normalizeString_(brow[battleIndex.result]);
        var reason = normalizeString_(brow[battleIndex.reason]);

        var isInRange =
          createdAt instanceof Date &&
          createdAt.getTime() >= cutoff.getTime();

        if (isInRange) {
          stats.battlesInRange++;

          if (result === "win") stats.winCount++;
          else if (result === "lose") stats.loseCount++;
          else if (result === "draw") stats.drawCount++;
          else if (result === "rejected") {
            stats.rejectedCount++;

            if (reason) {
              stats.rejectReasons[reason] =
                (stats.rejectReasons[reason] || 0) + 1;
            }
          }
        }
      }
    }
  } catch (errBattle) {}

  /*
   * GachaDraws 統計。
   */
  try {
    var gachaSheet = getGachaDrawSheet_();
    var lastGachaRow = gachaSheet.getLastRow();

    if (lastGachaRow > 1) {
      var gachaValues = gachaSheet.getDataRange().getValues();
      var gachaHeader = gachaValues[0];
      var gachaIndex = headerIndexMap_(gachaHeader);

      stats.totalGachaDraws = gachaValues.length - 1;

      for (var g = 1; g < gachaValues.length; g++) {
        var grow = gachaValues[g];
        var gCreatedAtRaw = grow[gachaIndex.createdAt];
        var gCreatedAt = gCreatedAtRaw instanceof Date
          ? gCreatedAtRaw
          : new Date(gCreatedAtRaw);

        var rewardName = normalizeString_(grow[gachaIndex.rewardName]) || "(未知獎項)";

        var isInRange =
          gCreatedAt instanceof Date &&
          !isNaN(gCreatedAt.getTime()) &&
          gCreatedAt.getTime() >= cutoff.getTime();

        if (isInRange) {
          stats.gachaDrawsInRange++;

          stats.gachaRewardBreakdown[rewardName] =
            (stats.gachaRewardBreakdown[rewardName] || 0) + 1;
        }
      }
    }
  } catch (errGacha) {}

  /*
   * SecretRedeemLogs 統計。
   */
  try {
    var redeemSheet = getSecretRedeemLogSheet_();
    var lastRedeemRow = redeemSheet.getLastRow();

    if (lastRedeemRow > 1) {
      var redeemValues = redeemSheet.getDataRange().getValues();
      var redeemHeader = redeemValues[0];
      var redeemIndex = headerIndexMap_(redeemHeader);

      stats.totalSecretRedeems = redeemValues.length - 1;

      for (var s = 1; s < redeemValues.length; s++) {
        var srow = redeemValues[s];
        var sCreatedAtRaw = srow[redeemIndex.createdAt];
        var sCreatedAt = sCreatedAtRaw instanceof Date
          ? sCreatedAtRaw
          : new Date(sCreatedAtRaw);

        var sResult = normalizeString_(srow[redeemIndex.result]);

        var isInRange =
          sCreatedAt instanceof Date &&
          !isNaN(sCreatedAt.getTime()) &&
          sCreatedAt.getTime() >= cutoff.getTime();

        if (isInRange) {
          stats.secretRedeemsInRange++;

          if (sResult === "success") {
            stats.secretRedeemSuccessInRange++;
          }
        }
      }
    }
  } catch (errRedeem) {}

  return stats;
}


function handleExportCsv(e) {
  var sheetName = getSafeParameter_(e, "sheet", "raw");
  var sheet = null;

  switch (sheetName) {
    case "players":
      sheet = getPlayerSheet_();
      break;
    case "battleLogs":
      sheet = getBattleLogSheet_();
      break;
    case "dailyScoreLogs":
      sheet = getDailyScoreLogSheet_();
      break;
    case "gachaDraws":
      sheet = getGachaDrawSheet_();
      break;
    case "secretCodes":
      sheet = getSecretCodeSheet_();
      break;
    case "secretRedeemLogs":
      sheet = getSecretRedeemLogSheet_();
      break;
    case "playerSecretUnlocks":
      sheet = getPlayerSecretUnlockSheet_();
      break;
    case "referral":
      sheet = getReferralSheet_();
      break;
    case "raw":
    default:
      sheet = getRawSheet_();
      break;
  }

  var csv = sheetToCsv_(sheet);

  return ContentService
    .createTextOutput(csv)
    .setMimeType(ContentService.MimeType.CSV);
}

function sheetToCsv_(sheet) {
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();

  if (lastRow === 0 || lastCol === 0) {
    return "";
  }

  var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();

  return values.map(function(row) {
    return row.map(function(cell) {
      if (cell instanceof Date) {
        return Utilities.formatDate(cell, "Asia/Taipei", "yyyy-MM-dd HH:mm:ss");
      }

      var str = String(cell === null || cell === undefined ? "" : cell);

      if (str.indexOf(",") !== -1 || str.indexOf("\"") !== -1 || str.indexOf("\n") !== -1) {
        str = "\"" + str.replace(/"/g, "\"\"") + "\"";
      }

      return str;
    }).join(",");
  }).join("\n");
}

