var MIN_GACHA_INTERVAL_MS = 1200;

/*
 * =========================================================
 * 安全扭蛋抽獎（後端權威版本）
 * =========================================================
 *
 * 前端只需傳：
 * {
 *   action: "gacha_draw_secure",
 *   userId, lineUserId, playerName, referralCode, pictureUrl,
 *   poolId,
 *   clientNonce   // 前端產生的一次性亂數，防止重複送出
 * }
 *
 * 後端會：
 * 1. 從 Players.zeloPoints 讀取真實點數（不採信前端點數）
 * 2. 檢查點數是否足夠
 * 3. 扣點
 * 4. 用伺服器亂數重新抽獎（不採信前端 rewardType/rewardId）
 * 5. 若抽中 points 類型，加點
 * 6. 寫入 Players.zeloPoints 與 GachaDraws
 * 7. 回傳結果給前端顯示
 */
function drawGachaSecure_(payload) {
  payload = payload || {};

  var lock = LockService.getScriptLock();

  try {
    lock.waitLock(5000);
  } catch (errorLock) {
    return {
      ok: false,
      code: "LOCK_TIMEOUT",
      result: "error",
      action: "gacha_draw_secure",
      message: "系統忙碌中，請稍後再試。",
      version: GAS_VERSION
    };
  }

  try {
    var now = new Date();

    var userId = normalizeUserIdFromPayload_(payload);

    if (
  !userId ||
  userId === "me-local" ||
  userId === "guest" ||
  userId === "anonymous" ||
  !isValidUserId(userId)
) {
  return {
    ok: false,
    code: "INVALID_USER_ID",
    result: "error",
    action: "gacha_draw_secure",
    message: "缺少有效 LINE userId，未進行正式抽獎結算。",
    version: GAS_VERSION
  };
}


    var displayName = sanitizeText_(
      payload.displayName ||
      payload.playerName ||
      payload.name ||
      "玩家",
      60
    );

    var pictureUrl = sanitizeText_(payload.pictureUrl || "", 500);

    var referralCode = normalizeReferralCode_(
      payload.referralCode ||
      payload.myReferralCode ||
      ""
    );

    var poolId = normalizePoolId_(payload.poolId);

    if (!poolId) {
      return {
        ok: false,
        code: "MISSING_POOL_ID",
        result: "error",
        action: "gacha_draw_secure",
        message: "缺少 poolId。",
        version: GAS_VERSION
      };
    }

    var pool = getGachaPoolByIdServer_(poolId);

    if (!pool) {
      return {
        ok: false,
        code: "POOL_NOT_FOUND",
        result: "error",
        action: "gacha_draw_secure",
        message: "找不到此獎池，請重新整理頁面後再試。",
        poolId: poolId,
        version: GAS_VERSION
      };
    }

    var clientNonce = sanitizeText_(
      payload.clientNonce ||
      payload.nonce ||
      "",
      120
    );

    var gachaSheet = getGachaDrawSheet_();
    ensureGenericHeader_(gachaSheet, GACHA_DRAW_HEADERS);

    /*
     * 去重：同一 userId + clientNonce 已經抽過，
     * 直接回傳上一次的結果，不重複扣點抽獎。
     */
    if (clientNonce) {
      var duplicated = gachaNonceAlreadyUsed_(gachaSheet, userId, clientNonce);

      if (duplicated) {
        return {
          ok: true,
          code: "DUPLICATE_DRAW",
          result: "ignored",
          action: "gacha_draw_secure",
          duplicated: true,
          message: "此次抽獎已處理過，顯示先前結果。",

          drawId: duplicated.drawId,
          poolId: poolId,

          reward: {
            rewardId: duplicated.rewardId,
            rewardName: duplicated.rewardName,
            rewardType: duplicated.rewardType,
            isNoPrize: duplicated.isNoPrize
          },

          claimStatus: duplicated.claimStatus,
          zeloPoints: duplicated.afterPoints,

          version: GAS_VERSION
        };
      }
    }

    var playersSheet = getPlayerSheet_();

    var playerInfo = findOrCreatePlayer_(
      playersSheet,
      userId,
      displayName,
      pictureUrl,
      referralCode,
      now
    );

    var player = playerInfo.player;
    var playerRowIndex = playerInfo.rowIndex;

    /*
     * 冷卻時間，避免瞬間連續送出多次抽獎請求。
     */
    var lastGachaAtMs = player.lastGachaAt
      ? new Date(player.lastGachaAt).getTime()
      : 0;

    if (
      lastGachaAtMs &&
      now.getTime() - lastGachaAtMs < MIN_GACHA_INTERVAL_MS
    ) {
      return {
        ok: false,
        code: "TOO_FAST",
        result: "rejected",
        action: "gacha_draw_secure",
        message: "抽獎太快了，請稍後再試。",
        zeloPoints: Number(player.zeloPoints || 0),
        version: GAS_VERSION
      };
    }

    var currentPoints = Number(player.zeloPoints || 0);
    var cost = Math.max(0, Number(pool.cost || 0));

    if (currentPoints < cost) {
      return {
        ok: false,
        code: "INSUFFICIENT_POINTS",
        result: "rejected",
        action: "gacha_draw_secure",
        message: "ZELO Points 不足，無法抽取此獎池。",
        zeloPoints: currentPoints,
        cost: cost,
        remaining: cost - currentPoints,
        poolId: poolId,
        version: GAS_VERSION
      };
    }

    /*
     * 後端重新抽獎，完全不採信前端傳來的任何獎品資訊。
     */
    var reward = pickWeightedGachaRewardServer_(pool.rewards);

    if (!reward) {
      return {
        ok: false,
        code: "POOL_EMPTY",
        result: "error",
        action: "gacha_draw_secure",
        message: "此獎池目前沒有可抽獎項，請稍後再試。",
        poolId: poolId,
        version: GAS_VERSION
      };
    }

    var afterCostPoints = currentPoints - cost;
    var isNoPrize = reward.type === "none";

    var rewardPointsDelta = reward.type === "points"
      ? Number(reward.points || 0)
      : 0;

    var afterPoints = afterCostPoints + rewardPointsDelta;

    var claimStatus = "pending";

    if (reward.type === "none") {
      claimStatus = "none";
    } else if (reward.type === "points") {
      claimStatus = "auto_granted";
    }

    /*
     * 寫回 Players 權威點數。
     */
    updatePlayer_(
      playersSheet,
      playerRowIndex,
      {
        displayName: displayName,
        pictureUrl: pictureUrl,
        referralCode: referralCode,
        zeloPoints: afterPoints,
        lastGachaAt: now,
        updatedAt: now
      }
    );

    var drawId =
      "secure_draw_" +
      now.getTime().toString(36) +
      "_" +
      Math.random().toString(36).slice(2, 8);

    var createdAtLocal = Utilities.formatDate(
      now,
      "Asia/Taipei",
      "yyyy-MM-dd HH:mm:ss"
    );

    var clientVersion = sanitizeText_(payload.version || "", 120);

    gachaSheet.appendRow([
      now.toISOString(),
      createdAtLocal,
      drawId,
      "backend_secure",
      "handleGachaDrawSecure",

      userId,
      sanitizeText_(payload.lineUserId || userId, 160),
      displayName,
      referralCode,

      poolId,
      sanitizeText_(pool.title || "", 100),
      "",
      "",
      cost,

      sanitizeText_(reward.id || "", 120),
      sanitizeText_(reward.name || "", 200),
      sanitizeText_(reward.type || "", 80),
      Number(reward.points || 0),
      sanitizeText_(reward.rarity || "", 80),
      sanitizeText_(reward.delivery || "", 120),
      isNoPrize,

      currentPoints,
      afterCostPoints,
      afterPoints,
      rewardPointsDelta,

      reward.type !== "none" && reward.type !== "points",
      "verified",
      clientVersion,
      GAS_VERSION,
      JSON.stringify(payload),

      claimStatus,
