 * ZELO_GACHA_POOLS_SERVER
 * =========================================================
 * 這份是後端權威版本，只保留計算抽獎必要的欄位
 * （cost / rewards / weight），不含圖片影片網址。
 *
 * ⚠️ 前端 ZELO_GACHA_POOLS 內容有異動時（新增獎品、調整機率），
 * 這裡務必手動同步更新，否則前後端抽獎機率會不一致。
 * =========================================================
 */

/*
 * 標準化玩家傳進來的 poolId。
 * 去除頭尾空白，避免因為前端多打一個空格或大小寫不一致，
 * 導致找不到對應的獎池設定。
 */
function normalizePoolId_(poolId) {
  if (poolId === null || poolId === undefined) {
    return "";
  }
  return String(poolId).trim();
}


/*
 * 依照 poolId 從 ZELO_GACHA_POOLS_SERVER 找出對應的獎池設定。
 * 找不到時回傳 null，讓呼叫端自行判斷要回什麼錯誤代碼。
 */
function getGachaPoolByIdServer_(poolId) {
  var normalizedId = normalizePoolId_(poolId);

  for (var i = 0; i < ZELO_GACHA_POOLS_SERVER.length; i++) {
    var pool = ZELO_GACHA_POOLS_SERVER[i];
    if (String(pool.id) === normalizedId) {
      return pool;
    }
  }

  return null;
}

/*
 * 檢查同一個 userId + clientNonce 是否已經抽過獎。
 * 用來防止玩家網路延遲重複點擊，導致同一次意圖被扣兩次點數。
 *
 * 找到重複紀錄時，回傳該筆紀錄的關鍵資訊（供前端顯示上次結果用）；
 * 找不到則回傳 null。
 */
function gachaNonceAlreadyUsed_(sheet, userId, clientNonce) {
  if (!sheet || !userId || !clientNonce) return null;

  ensureGenericHeader_(sheet, GACHA_DRAW_HEADERS);

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return null;

  var header = sheet
    .getRange(1, 1, 1, sheet.getLastColumn())
    .getValues()[0];

  var index = headerIndexMap_(header);

  /*
   * 只掃最近 5000 筆，避免資料量大時效能變差。
   */
  var checkRows = Math.min(lastRow - 1, 5000);
  var startRow = lastRow - checkRows + 1;

  var data = sheet
    .getRange(startRow, 1, checkRows, sheet.getLastColumn())
    .getValues();

  var targetUserId = String(userId);
  var targetNonce = String(clientNonce);

  for (var i = data.length - 1; i >= 0; i--) {
    var row = data[i];

    if (
      String(row[index.userId] || "") === targetUserId &&
      String(row[index.clientNonce] || "") === targetNonce
    ) {
      return {
        drawId: String(row[index.drawId] || ""),
        rewardId: String(row[index.rewardId] || ""),
        rewardName: String(row[index.rewardName] || ""),
        rewardType: String(row[index.rewardType] || ""),
        isNoPrize:
          row[index.isNoPrize] === true ||
          String(row[index.isNoPrize]).toUpperCase() === "TRUE",
        claimStatus: String(row[index.claimStatus] || ""),
        afterPoints: Number(row[index.afterPoints] || 0)
      };
    }
  }

  return null;
}

/*
 * 依照每個獎品的 weight（權重）隨機抽出一個獎品。
 * weight 數字越大，被抽中的機率越高。
 *
 * 例如：weight 40 的項目，被抽中機率是 weight 20 項目的兩倍。
 */
function pickWeightedGachaRewardServer_(rewards) {
  if (!rewards || !rewards.length) return null;

  var totalWeight = 0;

  for (var i = 0; i < rewards.length; i++) {
    totalWeight += Number(rewards[i].weight || 0);
  }

  if (totalWeight <= 0) return null;

  var randomPoint = Math.random() * totalWeight;
  var cumulative = 0;

  for (var j = 0; j < rewards.length; j++) {
    cumulative += Number(rewards[j].weight || 0);

    if (randomPoint < cumulative) {
      return rewards[j];
    }
  }

  /*
   * 理論上不會執行到這裡，保底回傳最後一個獎品，避免因浮點數誤差回傳 null。
   */
  return rewards[rewards.length - 1];
}


