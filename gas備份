function sendReport(startDate, endDate, title) {
  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    MailApp.sendEmail(EMAIL_TO, title, "目前尚無任何資料。");
    return;
  }

  var values = sheet.getRange(2, 1, lastRow - 1, Math.min(sheet.getLastColumn(), RAW_HEADERS.length)).getValues();
  var startEpoch = startDate.getTime();
  var endEpoch = endDate.getTime();

  var periodStats = calcStats(values, startEpoch, endEpoch);
  var allTimeStats = calcStats(values, 0, endEpoch);

  var periodCoupon = getCouponConversionStats(startEpoch, endEpoch);
  var allTimeCoupon = getCouponConversionStats(0, endEpoch);

  var html = buildReportHtml(title, startDate, endDate, periodStats, allTimeStats, periodCoupon, allTimeCoupon);

  MailApp.sendEmail({
    to: EMAIL_TO,
    subject: title + "（" + Utilities.formatDate(endDate, "Asia/Taipei", "MM/dd") + "）",
    htmlBody: html
  });
}

function calcStats(values, startEpoch, endEpoch) {
  var stats = {
    totalEvents: 0,
    totalGames: 0,
    uniqueUsers: {},
    duplicateBlocked: 0,
    rankCount: { S: 0, A: 0, B: 0 },
    scoreSum: 0,
    scoreCount: 0,
    topCount: {},
    shareClick: 0,
    shopClick: 0,
    copyClick: 0,
    replayClick: 0
  };

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var rowTimeVal = row[0];
    var eventType = normalizeGameEventType_(row[1], {});
    var userId = row[3];
    var topName = row[4];
    var score = row[13];
    var rank = row[14];
    var duplicateFlag = row[18];
    var epoch = row[19];

    if (!epoch && rowTimeVal instanceof Date) {
      epoch = rowTimeVal.getTime();
    }

    if (!epoch || Number(epoch) < startEpoch || Number(epoch) >= endEpoch) continue;

    stats.totalEvents++;

    if (userId) {
      stats.uniqueUsers[userId] = true;
    }

    if (eventType === "result") {
      stats.totalGames++;

      if (rank === "S" || rank === "A" || rank === "B") {
        stats.rankCount[rank]++;
      }

      if (typeof score === "number") {
        stats.scoreSum += score;
        stats.scoreCount++;
      } else if (score !== "" && score !== null && score !== undefined && !isNaN(Number(score))) {
        stats.scoreSum += Number(score);
        stats.scoreCount++;
      }

      if (topName) {
        stats.topCount[topName] = (stats.topCount[topName] || 0) + 1;
      }

      if (duplicateFlag) {
        stats.duplicateBlocked++;
      }
    }

    if (eventType === "share") stats.shareClick++;
    if (eventType === "official_click") stats.shopClick++;
    if (eventType === "coupon_copy") stats.copyClick++;
    if (eventType === "play_again") stats.replayClick++;
  }

  return stats;
}

function getCouponConversionStats(startEpoch, endEpoch) {
  var sheet = getRawSheet_();
  ensureRawHeader_(sheet);

  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return { issued: 0, used: 0, rate: "0.0" };

  var values = sheet.getRange(2, 1, lastRow - 1, Math.min(sheet.getLastColumn(), RAW_HEADERS.length)).getValues();

  var issued = 0;
  var used = 0;

  for (var i = 0; i < values.length; i++) {
    var row = values[i];
    var eventType = normalizeGameEventType_(row[1], {});
    var rowTimeVal = row[0];
    var coupon = row[15];
    var couponStatus = row[20];
    var epoch = row[19];

    if (!epoch && rowTimeVal instanceof Date) {
      epoch = rowTimeVal.getTime();
    }

    if (startEpoch != null && (!epoch || Number(epoch) < startEpoch)) continue;
    if (endEpoch != null && (!epoch || Number(epoch) >= endEpoch)) continue;

    if (eventType === "result" && coupon) {
      issued++;

      if (couponStatus === "已使用") {
        used++;
      }
    }
  }

  var rate = issued > 0 ? (used / issued * 100).toFixed(1) : "0.0";
  return {
    issued: issued,
    used: used,
    rate: rate
  };
}

function buildReportHtml(title, startDate, endDate, period, allTime, periodCoupon, allTimeCoupon) {
  var tz = "Asia/Taipei";
  var fmt = "yyyy-MM-dd HH:mm";
  var startStr = Utilities.formatDate(startDate, tz, fmt);
  var endStr = Utilities.formatDate(endDate, tz, fmt);

  var uniqueCount = Object.keys(period.uniqueUsers).length;
  var allUniqueCount = Object.keys(allTime.uniqueUsers).length;

  var avgScore = period.scoreCount > 0 ? (period.scoreSum / period.scoreCount).toFixed(1) : "0";
  var allAvgScore = allTime.scoreCount > 0 ? (allTime.scoreSum / allTime.scoreCount).toFixed(1) : "0";

  var topRankingHtml = buildTopRankingHtml(period.topCount);

  var shareRate = period.totalGames > 0 ? ((period.shareClick / period.totalGames) * 100).toFixed(1) : "0";
  var shopRate = period.totalGames > 0 ? ((period.shopClick / period.totalGames) * 100).toFixed(1) : "0";

  var totalReferrals = getTotalReferralCount_();
  var secureStats = getSecureDashboardStats_();

  var html = ""
