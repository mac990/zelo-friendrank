        (res.ok === true || res.code === "TOO_FAST" || res.code === "DAILY_PLAY_LIMIT_REACHED")
      );
    }
  ));

  results.push(testRoute_(
    "doPost: save_result (舊版寫入)",
    function () {
      return callDoPost_({
        action: "save_result",
        userId: "route_test_legacy_user",
        playerName: "路由測試舊版玩家",
        score: 500,
        coupon: ""
      });
    },
    function (res) {
      return res && res.ok === true && res.result === "success";
    }
  ));

  results.push(testRoute_(
    "doPost: 未知 action 應被忽略",
    function () {
      return callDoPost_({
        action: "this_action_does_not_exist_xyz"
      });
    },
    function (res) {
      return res && res.ok === false && res.result === "ignored";
    }
  ));

  results.push(testRoute_(
    "doPost: Shopify Webhook 偵測 (無比對訂單)",
    function () {
      return callDoPost_({
        id: 999999999,
        order_number: 1001,
        total_price: "500.00",
        currency: "TWD",
        created_at: new Date().toISOString(),
        discount_codes: [
          { code: "NON_EXISTENT_COUPON_XYZ" }
        ]
      });
    },
    function (res) {
      /*
       * 只要不是 UNKNOWN_ACTION，就代表有正確分流到
       * handleShopifyOrderWebhook_，而不是被當成一般 action 處理。
       */
      return res && res.code !== "UNKNOWN_ACTION" && res.ok === true;
    }
  ));

  results.push(testRoute_(
    "doGet: recordBattleResult 應回傳 POST_REQUIRED",
    function () {
      return callDoGet_({ action: "recordBattleResult" });
    },
    function (res) {
      return res && res.ok === false && res.code === "POST_REQUIRED";
    }
  ));

  results.push(testRoute_(
    "doGet: gacha_draw 應回傳 POST_REQUIRED",
    function () {
      return callDoGet_({ action: "gacha_draw" });
    },
    function (res) {
      return res && res.ok === false && res.code === "POST_REQUIRED";
    }
  ));

  results.push(testRoute_(
    "doGet: secret_redeem 應回傳 POST_REQUIRED",
    function () {
      return callDoGet_({ action: "secret_redeem" });
    },
    function (res) {
      return res && res.ok === false && res.code === "POST_REQUIRED";
    }
  ));

  results.push(testRoute_(
    "doGet: get_referral_count 應正常回傳",
    function () {
      return callDoGet_({
        action: "get_referral_count",
        ownerReferralCode: "ZG_route_test_inviter"
      });
    },
    function (res) {
      return res && res.ok === true && typeof res.count === "number";
    }
  ));

  Logger.log("========================================");
  Logger.log("測試結果總覽");
  Logger.log("========================================");

  var passCount = 0;
  var failCount = 0;

  results.forEach(function (r) {
    if (r.passed) {
      passCount++;
      Logger.log("✅ 通過｜" + r.name);
    } else {
      failCount++;
      Logger.log("❌ 失敗｜" + r.name);
      Logger.log("    回傳內容：" + JSON.stringify(r.response));

      if (r.error) {
        Logger.log("    錯誤訊息：" + r.error);
      }
    }
  });

  Logger.log("========================================");
  Logger.log("總計：" + passCount + " 通過 / " + failCount + " 失敗 / 共 " + results.length + " 項測試");
  Logger.log("========================================");

  return {
    total: results.length,
    passed: passCount,
    failed: failCount,
    details: results
  };
}

/*
 * 執行單一測試案例，統一處理例外狀況與結果比對。
 */
function testRoute_(name, callFn, checkFn) {
  try {
    var response = callFn();
    var passed = checkFn(response);

    return {
      name: name,
      passed: !!passed,
      response: response,
      error: null
    };
  } catch (err) {
    return {
      name: name,
      passed: false,
      response: null,
      error: String(err && err.message ? err.message : err)
    };
  }
}

/*
 * 模擬前端以 POST 呼叫 doPost，並自動解析回傳的 JSON。
 */
function callDoPost_(bodyObj) {
  var fakeEvent = {
    postData: {
      contents: JSON.stringify(bodyObj || {}),
      type: "application/json"
    }
  };

  var output = doPost(fakeEvent);
  var text = output.getContent();

  try {
    return JSON.parse(text);
  } catch (parseErr) {
    return { ok: false, code: "PARSE_ERROR", raw: text };
  }
}

/*
 * 模擬前端以 GET 呼叫 doGet，並自動解析回傳的 JSON。
 */
function callDoGet_(paramsObj) {
  var fakeEvent = {
    parameter: paramsObj || {}
  };

  var output = doGet(fakeEvent);
  var text = output.getContent();

  try {
    return JSON.parse(text);
  } catch (parseErr) {
    return { ok: false, code: "PARSE_ERROR", raw: text };
  }
}



