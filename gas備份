/*
 * 【修正版】新增或更新兌換碼設定。
 * 若 secretId 已存在，則直接覆蓋更新該列資料，
 * 避免重複執行造成 SecretCodes 分頁出現多筆重複資料、
 * 導致修正內容永遠不會生效的問題。
 */
function addSecretCode_(secretId, redeemCode, toyId, toyName, maxUses) {
  var sheet = getSecretCodeSheet_();
  ensureGenericHeader_(sheet, SECRET_CODE_HEADERS);

  var values = sheet.getDataRange().getValues();
  var header = values[0] || SECRET_CODE_HEADERS;
  var index = headerIndexMap_(header);

  var normalizedSecretId = normalizeSecretId_(secretId);
  var targetRowIndex = -1;

  for (var i = 1; i < values.length; i++) {
    if (normalizeSecretId_(values[i][index.secretId]) === normalizedSecretId) {
      targetRowIndex = i + 1;
      break;
    }
  }

  var now = new Date();

  if (targetRowIndex === -1) {
    // 不存在，新增一列
    sheet.appendRow([
      secretId,
      String(redeemCode).trim().toUpperCase(),
      toyId,
      toyName,
      maxUses === undefined ? -1 : maxUses,
      0,
      true,
      now,
      now,
      ""
    ]);

    return "✅ 已新增兌換碼：" + secretId + " -> " + redeemCode;
  }

  // 已存在，覆蓋更新（保留原本的 usedCount，不歸零）
  sheet.getRange(targetRowIndex, index.redeemCode + 1).setValue(String(redeemCode).trim().toUpperCase());
  sheet.getRange(targetRowIndex, index.toyId + 1).setValue(toyId);
  sheet.getRange(targetRowIndex, index.toyName + 1).setValue(toyName);
  sheet.getRange(targetRowIndex, index.maxUses + 1).setValue(maxUses === undefined ? -1 : maxUses);
  sheet.getRange(targetRowIndex, index.active + 1).setValue(true);
  sheet.getRange(targetRowIndex, index.updatedAt + 1).setValue(now);

  return "🔄 已更新既有兌換碼：" + secretId + " -> " + redeemCode;
}


