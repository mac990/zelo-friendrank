function getRawSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
  }

  ensureRawHeader_(sheet);

  return sheet;
}

function ensureRawHeader_(sheet) {
  if (!sheet) return;

  var requiredColumns = RAW_HEADERS.length;
  var lastRow = sheet.getLastRow();

  if (lastRow === 0) {
    sheet.appendRow(RAW_HEADERS);
    sheet.getRange(1, 1, 1, requiredColumns).setFontWeight("bold");
    return;
  }

  var currentLastColumn = sheet.getLastColumn();

  if (currentLastColumn < requiredColumns) {
    sheet.insertColumnsAfter(currentLastColumn, requiredColumns - currentLastColumn);
  }

  var currentHeaders = sheet
    .getRange(1, 1, 1, requiredColumns)
    .getValues()[0]
    .map(function(item) {
      return String(item || "").trim();
    });

  var needUpdate = false;

  RAW_HEADERS.forEach(function(header, index) {
    if (currentHeaders[index] !== header) {
      needUpdate = true;
    }
  });

  if (needUpdate) {
