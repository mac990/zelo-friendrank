/*
 * 給前端開機時同步權威點數用，
 * 避免玩家換裝置/清快取後，localStorage 點數與後端不一致。
 */
function getZeloPointsSecure_(userId) {
  userId = normalizeString_(userId);

  if (!userId) {
    return {
      ok: false,
      userId: "",
      zeloPoints: 0,
      message: "Missing userId",
      version: GAS_VERSION
    };
  }

  var playersSheet = getPlayerSheet_();
  ensureGenericHeader_(playersSheet, PLAYER_HEADERS);

  var lastRow = playersSheet.getLastRow();

  if (lastRow <= 1) {
    return {
      ok: true,
      userId: userId,
      zeloPoints: 0,
      found: false,
      version: GAS_VERSION
    };
  }

  var values = playersSheet.getDataRange().getValues();
  var header = values[0];
  var index = headerIndexMap_(header);

  for (var i = 1; i < values.length; i++) {
    var row = values[i];

    if (String(row[index.userId] || "") === userId) {
      return {
        ok: true,
        userId: userId,
        zeloPoints: Number(row[index.zeloPoints] || 0),
        found: true,
        version: GAS_VERSION
      };
    }
  }

  return {
    ok: true,
    userId: userId,
    zeloPoints: 0,
    found: false,
    version: GAS_VERSION
  };
}


