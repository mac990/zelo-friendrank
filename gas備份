function toBoolValue_(v) {
  if (v === true) return true;
  if (v === false) return false;

  var s = String(v || "").trim().toUpperCase();
  return s === "TRUE" || s === "1" || s === "YES";
}



function ensureGenericHeader_(sheet, headers) {
  if (!sheet) return;

  headers = headers || [];

  var requiredColumns = headers.length;
  var lastRow = sheet.getLastRow();

  if (lastRow === 0) {
    sheet.appendRow(headers);

    if (requiredColumns > 0) {
      sheet.getRange(1, 1, 1, requiredColumns).setFontWeight("bold");
    }

    return;
  }

  var currentLastColumn = sheet.getLastColumn();

  if (currentLastColumn < requiredColumns) {
    sheet.insertColumnsAfter(currentLastColumn, requiredColumns - currentLastColumn);
  }

  var currentHeaders = sheet
    .getRange(1, 1, 1, Math.max(requiredColumns, sheet.getLastColumn()))
    .getValues()[0]
    .map(function(item) {
      return String(item || "").trim();
    });

  var changed = false;

  headers.forEach(function(header) {
    if (currentHeaders.indexOf(header) === -1) {
      currentHeaders.push(header);
      changed = true;
    }
  });

  if (changed) {
    sheet
      .getRange(1, 1, 1, currentHeaders.length)
      .setValues([currentHeaders]);
  }

  sheet
    .getRange(1, 1, 1, Math.max(requiredColumns, sheet.getLastColumn()))
    .setFontWeight("bold");
}


